/-- The lifted representable-subcategory map generated by a Stokes cancellation rewrite. -/
def TraceRewriteGenerator.stokesRepresentableSubcategoryMap
    (source target : QTraceExpression) :
    (TraceCorQRepresentablePresheaf.yoneda).obj
        (TraceRewriteGenerator.stokes source target).sourceObject ⟶
      (TraceCorQRepresentablePresheaf.yoneda).obj
        (TraceRewriteGenerator.stokes source target).targetObject :=
  (TraceRewriteGenerator.stokes source target).representableSubcategoryMap

