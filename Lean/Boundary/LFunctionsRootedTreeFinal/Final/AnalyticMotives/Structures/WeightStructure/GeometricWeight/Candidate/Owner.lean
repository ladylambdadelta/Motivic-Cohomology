import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Structures.WeightStructure.GeometricWeight.ResidueDepth.Owner

/-!
# Geometric weight candidate

This file owns the candidate weight structure generated by boundary strata and
residue depth.  Trace compatibility checks are downstream.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/--
A geometric-contour weight candidate on the stable analytic motive interface.
Weights are indexed by boundary strata and residue depth, not by trace
positivity.
-/
structure GeometricWeightCandidate
    (S : AnalyticMotivicStableInfinityInterface) where
  StratumIndex : Type
  stratum : StratumIndex → GeometricWeightStratum S
  residueDepth : (i : StratumIndex) → GeometricResidueDepth (stratum i)
  lowerWeight : Int → S.Object → Type
  upperWeight : Int → S.Object → Type

namespace GeometricWeightCandidate

/-- The stratum selected by a geometric-weight index. -/
def stratumAt {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S) (i : W.StratumIndex) :
    GeometricWeightStratum S :=
  W.stratum i

/-- The residue depth selected by a geometric-weight index. -/
def depthAt {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S) (i : W.StratumIndex) :
    Nat :=
  (W.residueDepth i).depth

/-- The stable-interface object selected by a geometric-weight index. -/
def objectAt {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S) (i : W.StratumIndex) :
    S.Object :=
  (W.stratumAt i).stableObject

/-- The contour-admissible bulk selected by a geometric-weight index. -/
def bulkAt {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S) (i : W.StratumIndex) :
    ContourAdmissibleBulk :=
  (W.stratumAt i).bulk

/-- The boundary face selected by a geometric-weight index. -/
def faceAt {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S) (i : W.StratumIndex) :
    AnalyticBoundaryFace (W.bulkAt i).boundary.compactification :=
  (W.stratumAt i).face

/-- The residue-depth filtration selected by a geometric-weight index. -/
def filtrationAt {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S) (i : W.StratumIndex) :
    AnalyticResidueFiltration (W.bulkAt i).boundary :=
  (W.residueDepth i).filtration

/-- The selected residue depth agrees with the selected residue filtration. -/
theorem depth_eq_filtrationAt {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S) (i : W.StratumIndex) :
    W.depthAt i =
      (W.filtrationAt i).depth (W.stratumAt i).faceIndex :=
  GeometricResidueDepth.depth_eq_filtration (W.residueDepth i)

/-- Membership in the lower-weight class of a candidate. -/
def inLowerWeight {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S)
    (n : Int) (X : S.Object) : Type :=
  W.lowerWeight n X

/-- Membership in the upper-weight class of a candidate. -/
def inUpperWeight {S : AnalyticMotivicStableInfinityInterface}
    (W : GeometricWeightCandidate S)
    (n : Int) (X : S.Object) : Type :=
  W.upperWeight n X

end GeometricWeightCandidate

end AnalyticMotives
end LFunctions
end Boundary
