/-! ## Item 9j — `BoundaryCodeContract` iff surface for BoundaryTraceClass -/

/-- Iff form combining sound and complete for any `BoundaryCodeContract`. -/
theorem BoundaryCodeContract.code_eq_iff_boundaryEquiv
    (B : BoundaryCodeContract.{u, v} setup)
    {w₁ w₂ : FrontierWord setup} :
    B.boundaryCode w₁ = B.boundaryCode w₂ ↔ FrontierWord.BoundaryEquiv w₁ w₂ :=
  ⟨B.complete, B.sound⟩

/-- Soundness alias for `BoundaryCodeContract`. -/
theorem BoundaryCodeContract.sound_apply
    (B : BoundaryCodeContract.{u, v} setup)
    {w₁ w₂ : FrontierWord setup}
    (h : FrontierWord.BoundaryEquiv w₁ w₂) :
    B.boundaryCode w₁ = B.boundaryCode w₂ :=
  B.sound h

/-- Completeness alias for `BoundaryCodeContract`. -/
theorem BoundaryCodeContract.complete_apply
    (B : BoundaryCodeContract.{u, v} setup)
    {w₁ w₂ : FrontierWord setup}
    (h : B.boundaryCode w₁ = B.boundaryCode w₂) :
    FrontierWord.BoundaryEquiv w₁ w₂ :=
  B.complete h

