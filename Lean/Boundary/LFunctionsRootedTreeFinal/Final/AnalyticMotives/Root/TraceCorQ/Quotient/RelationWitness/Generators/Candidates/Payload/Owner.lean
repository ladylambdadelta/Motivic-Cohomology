theorem AnalyticMotivesRoot.traceCorQRelationGenerator_supportCandidate_importedRectangleCount_eq_length_importedRectangles
    (relation : TraceCorQRelationGenerator) :
    (TraceCorQRelationGenerator.supportCandidate relation).importedRectangleCount =
