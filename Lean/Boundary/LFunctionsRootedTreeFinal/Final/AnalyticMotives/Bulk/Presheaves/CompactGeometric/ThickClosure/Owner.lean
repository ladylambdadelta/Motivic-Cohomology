import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.CompactGeometric.CompactObjects.Owner

/-!
# Thick closure of compact analytic generators

This file owns the thick closure generated by compact analytic motives.
Idempotent completion is downstream.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/--
Thick-closure data generated by compact analytic generators.  It records a
finite family of generators and the stabilized presheaf obtained from their
closure operations.
-/
structure CompactAnalyticThickClosure where
  GeneratorIndex : Type
  finiteGeneratorIndex : Finite GeneratorIndex
  generator : GeneratorIndex → CompactAnalyticGenerator
  closedObject : TateStabilizedAnalyticPresheaf

namespace CompactAnalyticThickClosure

/-- The compact generator selected by an index in thick-closure data. -/
def generatorAt (C : CompactAnalyticThickClosure)
    (i : C.GeneratorIndex) : CompactAnalyticGenerator :=
  C.generator i

/-- The stabilized presheaf obtained from the thick closure. -/
def object (C : CompactAnalyticThickClosure) :
    TateStabilizedAnalyticPresheaf :=
  C.closedObject

/-- The source bulk of a selected generator in thick-closure data. -/
def generatorSource (C : CompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    ContourAdmissibleBulk :=
  (C.generatorAt i).source

/-- The stabilized presheaf of a selected generator in thick-closure data. -/
def generatorStabilized (C : CompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    TateStabilizedAnalyticPresheaf :=
  (C.generatorAt i).stabilized

/-- The underlying interval-local presheaf of the thick-closure closed object. -/
def underlyingPresheaf (C : CompactAnalyticThickClosure) :
    IntervalLocalAnalyticPresheaf :=
  C.closedObject.presheaf

/-- The analytic Tate object selected by the thick-closure closed object. -/
def tate (C : CompactAnalyticThickClosure) :
    AnalyticTateObject :=
  C.closedObject.tateObject

/-- The inverse Tate shift of the thick-closure closed object. -/
def inverseUnderlying (C : CompactAnalyticThickClosure) :
    IntervalLocalAnalyticPresheaf :=
  C.closedObject.inverseUnderlying

/-- Tensoring the inverse Tate shift recovers the thick-closure closed object. -/
theorem tensor_inverseUnderlying_eq (C : CompactAnalyticThickClosure) :
    C.closedObject.tensorAction.tensorObject C.inverseUnderlying =
      C.closedObject.presheaf :=
  TateStabilizedAnalyticPresheaf.tensor_inverseUnderlying_eq
    C.closedObject

end CompactAnalyticThickClosure

/--
Thick-closure data generated by functorial compact analytic generators.
-/
structure FunctorialCompactAnalyticThickClosure where
  GeneratorIndex : Type
  finiteGeneratorIndex : Finite GeneratorIndex
  generator : GeneratorIndex → FunctorialCompactAnalyticGenerator
  closedObject : FunctorialTateStabilizedAnalyticPresheaf

namespace FunctorialCompactAnalyticThickClosure

/-- Forget functorial transfer laws from functorial thick-closure data. -/
def forget (C : FunctorialCompactAnalyticThickClosure) :
    CompactAnalyticThickClosure where
  GeneratorIndex := C.GeneratorIndex
  finiteGeneratorIndex := C.finiteGeneratorIndex
  generator := fun i => (C.generator i).forget
  closedObject := C.closedObject.forget

/-- The functorial compact generator selected by an index. -/
def generatorAt (C : FunctorialCompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    FunctorialCompactAnalyticGenerator :=
  C.generator i

/-- The functorial Tate-stabilized closed object of a thick closure. -/
def object (C : FunctorialCompactAnalyticThickClosure) :
    FunctorialTateStabilizedAnalyticPresheaf :=
  C.closedObject

/-- The source bulk of a selected functorial generator in thick-closure data. -/
def generatorSource (C : FunctorialCompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    ContourAdmissibleBulk :=
  (C.generatorAt i).source

/-- The stabilized presheaf of a selected functorial generator. -/
def generatorStabilized (C : FunctorialCompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    FunctorialTateStabilizedAnalyticPresheaf :=
  (C.generatorAt i).stabilized

/-- The forgotten underlying interval-local presheaf of the closed object. -/
def underlyingPresheaf (C : FunctorialCompactAnalyticThickClosure) :
    IntervalLocalAnalyticPresheaf :=
  C.closedObject.presheaf.forget

/-- The analytic Tate object selected by the closed object. -/
def tate (C : FunctorialCompactAnalyticThickClosure) :
    AnalyticTateObject :=
  C.closedObject.tateObject

/-- The inverse Tate shift of the forgotten underlying presheaf. -/
def inverseUnderlying (C : FunctorialCompactAnalyticThickClosure) :
    IntervalLocalAnalyticPresheaf :=
  C.closedObject.inverseUnderlying

/-- Tensoring the inverse Tate shift recovers the forgotten underlying presheaf. -/
theorem tensor_inverseUnderlying_eq
    (C : FunctorialCompactAnalyticThickClosure) :
    C.closedObject.tensorAction.tensorObject C.inverseUnderlying =
      C.closedObject.presheaf.forget :=
  FunctorialTateStabilizedAnalyticPresheaf.tensor_inverseUnderlying_eq
    C.closedObject

/-- The transfer action retained by the closed object of a functorial thick closure. -/
def transferAction (C : FunctorialCompactAnalyticThickClosure) :
    RationalContourTransferAction
      C.closedObject.presheaf.descentLocal.presheafWithTransfers.presheaf :=
  FunctorialTateStabilizedAnalyticPresheaf.transferAction C.closedObject

/-- The transfer action retained by a selected generator in a functorial thick closure. -/
def generatorTransferAction
    (C : FunctorialCompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    RationalContourTransferAction
      ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers).presheaf :=
  FunctorialCompactAnalyticGenerator.transferAction (C.generator i)

/--
Reindexing invariance for pullbacks carried by the closed object of a
functorial compact analytic thick closure.
-/
theorem reindexing_pullback_eq
    (C : FunctorialCompactAnalyticThickClosure)
    {X Y : ContourCorrespondenceObject}
    (f g : RationalContourHom X Y)
    (R : RationalContourCombinationReindexing f g) :
    (transferAction C).act f = (transferAction C).act g :=
  FunctorialTateStabilizedAnalyticPresheaf.reindexing_pullback_eq
    C.closedObject f g R

/--
Reindexing invariance for pullbacks carried by a selected generator in a
functorial compact analytic thick closure.
-/
theorem generator_reindexing_pullback_eq
    (C : FunctorialCompactAnalyticThickClosure)
    (i : C.GeneratorIndex)
    {X Y : ContourCorrespondenceObject}
    (f g : RationalContourHom X Y)
    (R : RationalContourCombinationReindexing f g) :
    (generatorTransferAction C i).act f =
      (generatorTransferAction C i).act g :=
  FunctorialCompactAnalyticGenerator.reindexing_pullback_eq
    (C.generator i) f g R

/-- Left identity for pullbacks carried by the closed object of a thick closure. -/
theorem left_identity_pullback_eq
    (C : FunctorialCompactAnalyticThickClosure)
    {X Y : ContourCorrespondenceObject}
    (f : RationalContourHom X Y) :
    (transferAction C).act
        (C.closedObject.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose
          (C.closedObject.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.identity X)
          f) =
      (transferAction C).act f :=
  FunctorialTateStabilizedAnalyticPresheaf.left_identity_pullback_eq
    C.closedObject f

/-- Right identity for pullbacks carried by the closed object of a thick closure. -/
theorem right_identity_pullback_eq
    (C : FunctorialCompactAnalyticThickClosure)
    {X Y : ContourCorrespondenceObject}
    (f : RationalContourHom X Y) :
    (transferAction C).act
        (C.closedObject.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose f
          (C.closedObject.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.identity Y)) =
      (transferAction C).act f :=
  FunctorialTateStabilizedAnalyticPresheaf.right_identity_pullback_eq
    C.closedObject f

/-- Associativity for pullbacks carried by the closed object of a thick closure. -/
theorem associativity_pullback_eq
    (C : FunctorialCompactAnalyticThickClosure)
    {W X Y Z : ContourCorrespondenceObject}
    (f : RationalContourHom W X)
    (g : RationalContourHom X Y)
    (h : RationalContourHom Y Z) :
    (transferAction C).act
        (C.closedObject.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose
          (C.closedObject.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose
            f g) h) =
      (transferAction C).act
        (C.closedObject.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose f
          (C.closedObject.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose
            g h)) :=
  FunctorialTateStabilizedAnalyticPresheaf.associativity_pullback_eq
    C.closedObject f g h

/-- Left identity for pullbacks carried by a selected thick-closure generator. -/
theorem generator_left_identity_pullback_eq
    (C : FunctorialCompactAnalyticThickClosure)
    (i : C.GeneratorIndex)
    {X Y : ContourCorrespondenceObject}
    (f : RationalContourHom X Y) :
    (generatorTransferAction C i).act
        ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose
          ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.identity X)
          f) =
      (generatorTransferAction C i).act f :=
  FunctorialCompactAnalyticGenerator.left_identity_pullback_eq
    (C.generator i) f

/-- Right identity for pullbacks carried by a selected thick-closure generator. -/
theorem generator_right_identity_pullback_eq
    (C : FunctorialCompactAnalyticThickClosure)
    (i : C.GeneratorIndex)
    {X Y : ContourCorrespondenceObject}
    (f : RationalContourHom X Y) :
    (generatorTransferAction C i).act
        ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose f
          ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.identity Y)) =
      (generatorTransferAction C i).act f :=
  FunctorialCompactAnalyticGenerator.right_identity_pullback_eq
    (C.generator i) f

/-- Associativity for pullbacks carried by a selected thick-closure generator. -/
theorem generator_associativity_pullback_eq
    (C : FunctorialCompactAnalyticThickClosure)
    (i : C.GeneratorIndex)
    {W X Y Z : ContourCorrespondenceObject}
    (f : RationalContourHom W X)
    (g : RationalContourHom X Y)
    (h : RationalContourHom Y Z) :
    (generatorTransferAction C i).act
        ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose
          ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose
            f g) h) =
      (generatorTransferAction C i).act
        ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose f
          ((C.generator i).stabilizedPresheaf.presheaf.descentLocal.presheafWithTransfers.functorialTransfer.rationalCategory.compose
            g h)) :=
  FunctorialCompactAnalyticGenerator.associativity_pullback_eq
    (C.generator i) f g h

end FunctorialCompactAnalyticThickClosure

end AnalyticMotives
end LFunctions
end Boundary
