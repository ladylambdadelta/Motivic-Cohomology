import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.DescentLocalization.CechObjects.Owner

/-!
# Descent local equivalences

This file owns the local equivalences generated by contour descent Cech
objects.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/--
A descent local-equivalence datum generated by a Cech object.  It records the
target value, the Cech object, and the comparison maps from the target value to
the Cech pieces.
-/
structure ContourDescentLocalEquivalence {F : AnalyticPresheafWithTransfers}
    {C : TransferPresheafDescentCover F}
    (K : ContourCechObject C) where
  targetValue : F.valueAt C.target
  restrictToPiece :
    (i : K.PieceIndex) → F.valueAt (K.pieceBulk i)

namespace ContourDescentLocalEquivalence

/-- The target value in a Cech-generated local-equivalence datum. -/
def target {F : AnalyticPresheafWithTransfers}
    {C : TransferPresheafDescentCover F}
    {K : ContourCechObject C}
    (E : ContourDescentLocalEquivalence K) :
    F.valueAt C.target :=
  E.targetValue

/-- The restriction value at a Cech piece. -/
def restrictionAt {F : AnalyticPresheafWithTransfers}
    {C : TransferPresheafDescentCover F}
    {K : ContourCechObject C}
    (E : ContourDescentLocalEquivalence K)
    (i : K.PieceIndex) : F.valueAt (K.pieceBulk i) :=
  E.restrictToPiece i

/-- The target bulk of a Cech-generated local-equivalence datum. -/
def targetBulk {F : AnalyticPresheafWithTransfers}
    {C : TransferPresheafDescentCover F}
    {K : ContourCechObject C}
    (E : ContourDescentLocalEquivalence K) :
    ContourAdmissibleBulk :=
  C.targetBulk

/-- The Cech piece bulk selected by a local-equivalence datum. -/
def pieceBulkAt {F : AnalyticPresheafWithTransfers}
    {C : TransferPresheafDescentCover F}
    {K : ContourCechObject C}
    (E : ContourDescentLocalEquivalence K)
    (i : K.PieceIndex) :
    ContourAdmissibleBulk :=
  K.bulkAt i

/-- The Cech piece value selected by a local-equivalence datum. -/
def pieceValueAt {F : AnalyticPresheafWithTransfers}
    {C : TransferPresheafDescentCover F}
    {K : ContourCechObject C}
    (E : ContourDescentLocalEquivalence K)
    (i : K.PieceIndex) :
    F.valueAt (E.pieceBulkAt i) :=
  K.valueAt i

end ContourDescentLocalEquivalence

end AnalyticMotives
end LFunctions
end Boundary
