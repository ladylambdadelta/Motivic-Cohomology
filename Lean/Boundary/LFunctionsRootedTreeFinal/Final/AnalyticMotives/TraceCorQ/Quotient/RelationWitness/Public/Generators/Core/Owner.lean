namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The trace-correspondence root exposes the support quotient input of a relation generator. -/
def TraceCorQ.relationGenerator_supportQuotientInput
    (relation : TraceCorQRelationGenerator) :
    TraceCorQQuotientInput :=
  TraceCorQRelationGenerator.supportQuotientInput
    relation

/-- The trace-correspondence root exposes support-input formal sums. -/
theorem TraceCorQ.relationGenerator_supportQuotientInput_formalSum
    (relation : TraceCorQRelationGenerator) :
    (TraceCorQRelationGenerator.supportQuotientInput relation).formalSum =
      relation.support :=
  TraceCorQRelationGenerator.supportQuotientInput_formalSum
    relation

/-- The trace-correspondence root exposes support-input singleton ledgers. -/
theorem TraceCorQ.relationGenerator_supportQuotientInput_ledger
    (relation : TraceCorQRelationGenerator) :
    (TraceCorQRelationGenerator.supportQuotientInput relation).ledger =
      TraceCorQRelationLedger.singleton relation :=
  TraceCorQRelationGenerator.supportQuotientInput_ledger
    relation

