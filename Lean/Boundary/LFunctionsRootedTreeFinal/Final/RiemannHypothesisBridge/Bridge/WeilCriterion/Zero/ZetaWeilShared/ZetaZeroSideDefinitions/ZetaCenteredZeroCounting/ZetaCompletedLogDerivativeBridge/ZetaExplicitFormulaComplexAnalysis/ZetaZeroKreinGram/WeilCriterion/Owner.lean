/-- Public raw-Weil positivity owner route from the direct completed-boundary
coordinate repair.

This is the narrow final analytic surface for the completed-boundary lane:
concrete completed-log-derivative control, Gamma slit-plane control, and the
canonical height-window residue equality. -/
theorem zetaWeilQuadraticPositivity_of_completedBoundaryDirectOwnerInputs
    (hConcrete :
      ZetaAdmissibleFunction.CompletedZetaNegLogDerivAutocorrelationConcreteControl)
    (hGammaSlit : Complex.GammaRightHalfPlaneSlitPlaneControl)
    (hheight : ZetaCompletedAutocorrelationCanonicalHeightWindowResidueEquality) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_canonicalPhi_completedBoundaryContourAssembly_concreteLogDeriv_gammaSlit_heightWindowResidueEquality_owner
    hConcrete
    hGammaSlit
    hheight

/-- Public normalized-boundary positivity route.  The concrete completed
log-derivative owner already supplies the scheduled normalized contour limit,
the pole-corrected boundary identification, and endpoint absorption; this route
therefore has no finite-residue-equality input. -/
theorem zetaWeilQuadraticPositivity_of_completedBoundaryConcreteLogDerivativeOwner
    (hConcrete :
      ZetaAdmissibleFunction.CompletedZetaNegLogDerivAutocorrelationConcreteControl) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_concreteLogDerivativeControl_owner hConcrete

/-- Public raw-Weil positivity owner route from direct residue-error
vanishing.

This names the residue-theoretic sink in the exact finite-rectangle residue
owner form. -/
theorem zetaWeilQuadraticPositivity_of_completedBoundaryResidueErrorOwnerInputs
    (hConcrete :
      ZetaAdmissibleFunction.CompletedZetaNegLogDerivAutocorrelationConcreteControl)
    (hGammaSlit : Complex.GammaRightHalfPlaneSlitPlaneControl)
    (hzero : ZetaCompletedAutocorrelationCanonicalResidueEqualityErrorVanishing) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_completedBoundaryDirectOwnerInputs
    hConcrete
    hGammaSlit
    (zetaCompletedAutocorrelationCanonicalHeightWindowResidueEquality_of_residueEqualityErrorVanishing
      hzero)

/-- Public raw-Weil positivity owner route from the canonical pointwise
finite-rectangle residue equality.  This keeps the residue sink at the exact
finite-rectangle theorem rather than at the already-transported error
vanishing surface. -/
theorem zetaWeilQuadraticPositivity_of_completedBoundaryPointwiseFiniteRectangleResidueOwnerInputs
    (hConcrete :
      ZetaAdmissibleFunction.CompletedZetaNegLogDerivAutocorrelationConcreteControl)
    (hGammaSlit : Complex.GammaRightHalfPlaneSlitPlaneControl)
    (hfinite :
      ∀ f : ZetaAdmissibleFunction,
        ∀ hPhi : ZetaAdmissibleFunction.ZetaPhiAnalyticControl
          (ZetaAdmissibleFunction.convolutionAutocorrelation f),
        ∀ hLog : ZetaAdmissibleFunction.CompletedZetaNegLogDerivControl
          (ZetaAdmissibleFunction.convolutionAutocorrelation f),
        ∀ u : ℝ,
          ZetaAdmissibleFunction.zetaCompletedExplicitFormulaContourIntegral
              (ZetaAdmissibleFunction.convolutionAutocorrelation f)
              ((ZetaAdmissibleFunction.zetaCompletedExplicitFormula_autocorrelation_contourFamily f).rectangle
                ((ZetaAdmissibleFunction.zetaCompletedExplicitFormula_autocorrelation_familyAnalyticPackage
                  f
                  (ZetaAdmissibleFunction.zetaCompletedExplicitFormulaAutocorrelationHorizontalAvoidingSchedule f)
                  hPhi
                  hLog).height_schedule.height u)) =
            ZetaAdmissibleFunction.explicitFormulaCompletedZeroContourHeightWindowResidueSum
              (ZetaAdmissibleFunction.convolutionAutocorrelation f)
              ((ZetaAdmissibleFunction.zetaCompletedExplicitFormula_autocorrelation_familyAnalyticPackage
                f
                (ZetaAdmissibleFunction.zetaCompletedExplicitFormulaAutocorrelationHorizontalAvoidingSchedule f)
                hPhi
                hLog).height_schedule.height u)) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_completedBoundaryResidueErrorOwnerInputs
    hConcrete
    hGammaSlit
    (zetaCompletedAutocorrelationCanonicalResidueEqualityErrorVanishing_of_pointwiseFiniteRectangleResidueEquality
      hfinite)

/-- Public raw-Weil positivity owner route from concrete completed-log-
derivative control and the scheduled finite-residue equality. -/
theorem zetaWeilQuadraticPositivity_of_completedBoundaryScheduledResidueOwnerInputs
    (hConcrete :
      ZetaAdmissibleFunction.CompletedZetaNegLogDerivAutocorrelationConcreteControl)
    (hGammaSlit : Complex.GammaRightHalfPlaneSlitPlaneControl)
    (hfinite : ZetaCompletedAutocorrelationScheduledFiniteResidueEquality) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_canonicalPhi_completedBoundaryFiniteResidueAssembly_concreteLogDeriv_gammaSlit_owner
    hConcrete
    hGammaSlit
    hfinite

/-- Public raw-Weil positivity route from the corrected scheduled-path affine
packet surface.

This is the narrow owner surface for the direct centered lane: horizontal
control is only required on the canonical scheduled top and bottom paths, while
the vertical physical endpoint is supplied by the affine packet data. -/
theorem zetaWeilQuadraticPositivity_of_canonicalScheduledCauchyPathPacketDataOwnerInputs
    (K : ZetaAdmissibleFunction → ℕ)
    (zetaData :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.CanonicalScheduledZetaSideCauchyPathData
          f (K f))
    (gammaData :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.CanonicalScheduledInverseGammaCauchyPathData
          f (K f))
    (packetData :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.ZetaCompletedAutocorrelationAffinePacketData f) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_canonicalScheduledCauchyPathData_packetData_traceBessel_owner
    K
    zetaData
    gammaData
    packetData

/-- Public raw-Weil positivity route from canonical scheduled Cauchy path data
and explicit affine analytic packages.

This peels the corrected packet-data surface one step further: the remaining
vertical endpoint inputs are the analytic packages that own the affine packet
component integrability and value identities. -/
theorem zetaWeilQuadraticPositivity_of_canonicalScheduledCauchyPathAnalyticPackagesOwnerInputs
    (K : ZetaAdmissibleFunction → ℕ)
    (zetaData :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.CanonicalScheduledZetaSideCauchyPathData
          f (K f))
    (gammaData :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.CanonicalScheduledInverseGammaCauchyPathData
          f (K f))
    (analyticPackage :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.ExplicitFormulaFamilyAnalyticPackage
          (ZetaAdmissibleFunction.convolutionAutocorrelation f)
          (ZetaAdmissibleFunction.zetaCompletedExplicitFormula_autocorrelation_contourFamily f))
    (regularAnalyticPackage :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.ExplicitFormulaFamilyAnalyticPackage
          (ZetaAdmissibleFunction.convolutionAutocorrelation f)
          (ZetaAdmissibleFunction.zetaCompletedAutocorrelationRegularFamily f).toContourFamily) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_canonicalScheduledCauchyPathData_analyticPackages_traceBessel_owner
    K
    zetaData
    gammaData
    analyticPackage
    regularAnalyticPackage

/-- Public raw-Weil positivity owner.

The final positivity theorem is a thin wrapper over the corrected
zero-side/physical-boundary common-limit theorem. -/
theorem zetaWeilQuadraticPositivity_of_horizontalBounds_owner
    (horizontalBounds :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.CanonicalScheduledPolynomialHorizontalBounds f) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_finalCommonLimit_owner
    (zetaCompletedAutocorrelationPoleCorrectedCommonLimit_owner horizontalBounds)

theorem zetaWeilQuadraticPositivity_of_canonicalScheduledCarrierCauchyData_owner
    (K : ZetaAdmissibleFunction → ℕ)
    (carrierData : CanonicalScheduledCarrierCauchyData K) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_finalCommonLimit_owner
    (zetaCompletedAutocorrelationPoleCorrectedCommonLimit_of_canonicalScheduledCarrierCauchyData_owner
      K
      carrierData)

theorem zetaWeilQuadraticPositivity_of_suppliedScheduleCarrierCauchyFamily_owner
    (data : ZetaAdmissibleFunction.SuppliedScheduleCarrierCauchyFamily)
    (heightEq :
      ∀ f : ZetaAdmissibleFunction,
        data.schedule f =
          ZetaAdmissibleFunction.zetaCompletedExplicitFormulaAutocorrelationCofinalHeightSchedule f) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_horizontalBounds_owner
    (ZetaAdmissibleFunction.canonicalScheduledPolynomialHorizontalBounds_of_suppliedScheduleCarrierCauchyFamily_owner
      data
      heightEq)

theorem zetaWeilQuadraticPositivity_of_canonicalScheduleCarrierCauchyData_owner
    (degree : ZetaAdmissibleFunction → ℕ)
    (carrierData :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.SuppliedScheduleCarrierCauchyData
          f
          (ZetaAdmissibleFunction.zetaCompletedExplicitFormulaAutocorrelationCofinalHeightSchedule
            f)
          (degree f))
    (separated :
      ∀ f : ZetaAdmissibleFunction,
        (ZetaAdmissibleFunction.zetaCompletedExplicitFormulaAutocorrelationScheduledHorizontalCarrier
          f).HasPositiveSingularSeparation)
    (phiControl :
      ∀ f : ZetaAdmissibleFunction,
        ZetaAdmissibleFunction.ZetaPhiAnalyticControl
          (ZetaAdmissibleFunction.convolutionAutocorrelation f)) :
    ZetaWeilQuadraticPositivity :=
  zetaWeilQuadraticPositivity_of_suppliedScheduleCarrierCauchyFamily_owner
    (ZetaAdmissibleFunction.SuppliedScheduleCarrierCauchyFamily.ofCanonicalSchedule
      degree carrierData separated phiControl)
    (fun f =>
      ZetaAdmissibleFunction.SuppliedScheduleCarrierCauchyFamily.ofCanonicalSchedule_schedule_eq
        degree carrierData separated phiControl f)

