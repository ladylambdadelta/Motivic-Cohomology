import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Stabilization.AdditiveEnvelope.Triangulated.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Weights.AdditiveEnvelope.Bounds.Homotopy.Owner

/-!
# Mapping-cone triangles generated by bounded maps

A chain map between bounded additive analytic complexes generates the usual
mapping-cone distinguished triangle in the additive analytic homotopy category.
This file records the bounded first two representatives and the distinguished
triangle generated by the underlying chain map.
-/

noncomputable section

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

open CategoryTheory

/-- The first bounded representative of a bounded-map mapping-cone triangle. -/
def TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.firstObject
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    TraceAnalyticAdditiveHomotopyCategory :=
  TraceAnalyticAdditiveHomotopyCategory.weightBoundedObject source

/-- The second bounded representative of a bounded-map mapping-cone triangle. -/
def TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.secondObject
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    TraceAnalyticAdditiveHomotopyCategory :=
  TraceAnalyticAdditiveHomotopyCategory.weightBoundedObject target

/-- The first morphism of a bounded-map mapping-cone triangle. -/
def TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.firstMap
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.firstObject hom ⟶
      TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.secondObject hom :=
  TraceAnalyticAdditiveHomotopyCategory.weightBoundedMap hom

/-- The mapping-cone triangle generated by a bounded-complex chain map. -/
def TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.triangle
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    Triangle TraceAnalyticAdditiveHomotopyCategory :=
  CochainComplex.mappingCone.triangleh hom

/-- The first bounded representative is the homotopy image of the source complex. -/
theorem TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.firstObject_eq
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.firstObject hom =
      TraceAnalyticAdditiveHomotopyCategory.weightBoundedObject source :=
  rfl

/-- The second bounded representative is the homotopy image of the target complex. -/
theorem TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.secondObject_eq
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.secondObject hom =
      TraceAnalyticAdditiveHomotopyCategory.weightBoundedObject target :=
  rfl

/-- The first map is the homotopy image of the bounded chain map. -/
theorem TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.firstMap_eq
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.firstMap hom =
      TraceAnalyticAdditiveHomotopyCategory.weightBoundedMap hom :=
  rfl

/-- The bounded-map mapping-cone triangle is the ordinary mapping-cone triangle. -/
theorem TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.triangle_eq
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.triangle hom =
      CochainComplex.mappingCone.triangleh hom :=
  rfl

/-- The mapping-cone triangle generated by a bounded map is distinguished. -/
theorem TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.triangle_distinguished
    {bound : Nat}
    {source target :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy bound}
    (hom :
      TraceAnalyticAdditiveCochainComplex.WeightBoundedBy.Hom source target) :
    TraceAnalyticAdditiveHomotopyCategory.BoundedMappingCone.triangle hom ∈
      TraceAnalyticAdditiveHomotopyCategory.distinguishedTriangles :=
  TraceAnalyticAdditiveHomotopyCategory.mappingCone_triangle_distinguished hom

end AnalyticMotives
end LFunctions
end Boundary
