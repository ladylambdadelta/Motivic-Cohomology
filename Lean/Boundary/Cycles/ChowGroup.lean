import Boundary.Cycles.RationalEquivalence

/-!
# Chow groups

This file forms the standard Chow-group quotient of algebraic cycles by the
rational-equivalence subgroup generated by principal divisors.

The construction follows Fulton, *Intersection Theory*, §1.3–§1.4, in the
dimension-graded form used throughout the project.
-/

universe u

open AlgebraicGeometry

namespace Boundary
namespace Cycles

noncomputable section

/-- The Chow group of a scheme, defined as the quotient of algebraic cycles by
rational equivalence. -/
abbrev ChowGroup (X : Scheme.{u}) : Type (u + 1) :=
  AlgCycle X ⧸ RationalEquivalenceAddSubgroup X

/-- The quotient map to the Chow group. -/
def toChow {X : Scheme.{u}} : AlgCycle X →+ ChowGroup X :=
  QuotientAddGroup.mk' _

/-- The Chow quotient map is surjective. -/
theorem toChow_surjective {X : Scheme.{u}} : Function.Surjective (@toChow X) := by
  intro q
  refine QuotientAddGroup.induction_on q ?_
  intro c
  exact ⟨c, rfl⟩

/-- The zero cycle maps to zero in the Chow group. -/
@[simp] theorem toChow_zero {X : Scheme.{u}} :
    toChow (0 : AlgCycle X) = 0 := by
  rfl

/-- The quotient map respects addition. -/
theorem toChow_add {X : Scheme.{u}} (c d : AlgCycle X) :
    toChow (c + d) = toChow c + toChow d := by
  rfl

/-- A principal divisor cycle vanishes in the Chow group. -/
theorem toChow_principalDivisorGenerator
    {X : Scheme.{u}} (D : PrincipalDivisorGenerator X) :
    toChow D.toCycle = 0 := by
  exact QuotientAddGroup.eq_zero_iff.mpr (principalDivisorGenerator_mem_rationalEquivalenceSubmodule D)

/-- Two algebraic cycles have the same Chow class exactly when they are
rationally equivalent. -/
theorem toChow_eq_iff {X : Scheme.{u}} (c d : AlgCycle X) :
    toChow c = toChow d ↔ RationallyEquivalent c d := by
  constructor
  · intro h
    rw [QuotientAddGroup.eq_iff_sub_mem] at h
    exact h
  · intro h
    rw [← QuotientAddGroup.eq_iff_sub_mem]
    exact h

/-- A cycle vanishes in the Chow group exactly when it is rationally
equivalent to zero. -/
theorem toChow_eq_zero_iff {X : Scheme.{u}} (c : AlgCycle X) :
    toChow c = 0 ↔ RationallyEquivalent c 0 := by
  constructor
  · intro h
    have h' : toChow c = toChow (0 : AlgCycle X) := by
      rw [toChow_zero]
      exact h
    exact (toChow_eq_iff (X := X) c 0).1 h'
  · intro h
    exact (toChow_eq_iff (X := X) c 0).2 h

/-- Rational equivalence is exactly the equality relation induced by the Chow
quotient. -/
theorem rationallyEquivalent_iff_toChow_eq {X : Scheme.{u}} (c d : AlgCycle X) :
    RationallyEquivalent c d ↔ toChow c = toChow d := by
  exact (toChow_eq_iff (X := X) c d).symm

end

end Cycles
end Boundary
