import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.TraceCorQ.RelationLedgers.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.TraceCorQ.Relations.NamedCoherence.Owner

/-!
# Relation ledgers generated by named coherence cells

This file packages the named coherence relation generators as singleton
relation ledgers.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The singleton relation ledger generated by a Fubini coherence relation. -/
def TraceCorQRelationLedger.fubini
    (source target : TraceRewritePath)
    (support : TraceCorQFormalSum) :
    TraceCorQRelationLedger :=
  TraceCorQRelationLedger.singleton
    (TraceCorQRelationGenerator.fubini
      source
      target
      support)

