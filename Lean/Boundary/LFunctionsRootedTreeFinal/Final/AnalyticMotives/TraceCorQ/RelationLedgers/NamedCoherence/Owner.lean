/-- A Fubini relation ledger has the corresponding singleton relation. -/
theorem TraceCorQRelationLedger.fubini_eq_singleton
    (source target : TraceRewritePath)
    (support : TraceCorQFormalSum) :
    TraceCorQRelationLedger.fubini source target support =
      TraceCorQRelationLedger.singleton
        (TraceCorQRelationGenerator.fubini
          source
          target
          support) :=
  rfl

