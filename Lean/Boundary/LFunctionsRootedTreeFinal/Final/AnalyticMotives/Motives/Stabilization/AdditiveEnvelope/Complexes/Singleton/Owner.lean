    (input.additiveTargetComplex.objectAt 0).length =
      1 :=
  Eq.trans
    (congrArg
      List.length
      (TraceLocalizationInput.additiveTargetComplex_objectAt_zero input))
    (TraceLocalizationInput.additiveTargetObject_length input)

end AnalyticMotives
end LFunctions
