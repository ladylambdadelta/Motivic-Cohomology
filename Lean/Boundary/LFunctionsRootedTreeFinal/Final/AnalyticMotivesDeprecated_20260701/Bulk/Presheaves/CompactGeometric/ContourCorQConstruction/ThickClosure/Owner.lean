import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.CompactGeometric.ContourCorQConstruction.Generators.Owner

/-!
# Constructed thick closure

This owner records finite thick-closure data generated by constructed compact
analytic generators.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- Thick-closure data for constructed compact analytic generators. -/
structure ConstructedCompactAnalyticThickClosure where
  GeneratorIndex : Type
  finiteGeneratorIndex : Finite GeneratorIndex
  generator : GeneratorIndex → ConstructedCompactAnalyticGenerator
  closedObject : ConstructedTateStabilizedAnalyticPresheaf

namespace ConstructedCompactAnalyticThickClosure

/-- The constructed compact generator selected by an index. -/
def generatorAt (C : ConstructedCompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    ConstructedCompactAnalyticGenerator :=
  C.generator i

/-- The closed constructed Tate-stabilized object. -/
def object (C : ConstructedCompactAnalyticThickClosure) :
    ConstructedTateStabilizedAnalyticPresheaf :=
  C.closedObject

/-- The source bulk of a selected generator. -/
def generatorSource (C : ConstructedCompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    ContourAdmissibleBulk :=
  (C.generatorAt i).source

/-- The stabilized presheaf of a selected generator. -/
def generatorStabilized (C : ConstructedCompactAnalyticThickClosure)
    (i : C.GeneratorIndex) :
    ConstructedTateStabilizedAnalyticPresheaf :=
  (C.generatorAt i).stabilized

/-- The closed object level at one Tate weight. -/
def closedLevelAt (C : ConstructedCompactAnalyticThickClosure)
    (n : Int) :
    ConstructedIntervalLocalAnalyticPresheaf :=
  C.closedObject.levelAt n

/-- The level of a selected generator at one Tate weight. -/
def generatorLevelAt (C : ConstructedCompactAnalyticThickClosure)
    (i : C.GeneratorIndex) (n : Int) :
    ConstructedIntervalLocalAnalyticPresheaf :=
  (C.generatorAt i).levelAt n

end ConstructedCompactAnalyticThickClosure

end AnalyticMotives
end LFunctions
end Boundary
