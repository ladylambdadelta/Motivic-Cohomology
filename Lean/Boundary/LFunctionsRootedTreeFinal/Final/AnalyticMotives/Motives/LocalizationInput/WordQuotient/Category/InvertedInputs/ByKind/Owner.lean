/-- The named descent-channel isomorphism is the generic localized-word isomorphism. -/
theorem TraceLocalizationInput.descentChannelIso_eq_localizedWordIso
    (source target : QTraceExpression) :
    TraceLocalizationInput.descentChannelIso source target =
      (TraceLocalizationInput.descentChannel source target).localizedWordIso :=
  rfl

