namespace RewriteCalculusSetup

open CompletedReconstructionRecord

variable {setup : RewriteCalculusSetup.{u}}

namespace PeelChain

/-! ### Adjacent-swap admin moves -/

/-- **Chain-level adjacent-swap admin move.**

`AdminMove c₁ c₂` holds when `c₁` and `c₂` differ by a single adjacent
swap of two independent sinks at the head of the chain.

The constructor `adjacent_swap` packages:
* the swap data `(s, t : Fin R.n)` with `IndependentSinks R s t`;
* `IsSink` witnesses for both `s` and `t` in `R`;
* the two **independent** post-swap tails — one a `PeelChain` of
  `peelSink (peelSink R s) (peelSinkOtherIdx s t _)`, the other of
  `peelSink (peelSink R t) (peelSinkOtherIdx t s _)`.

Per the file-level *honest scope* note: the two tails are independent
`PeelChain` instances because the two two-step residues are only
`RecordStructEquiv BoundaryAdminEquiv` (not definitionally equal),
so they cannot share a single tail term. -/
inductive AdminMove :
    ∀ {R : CompletedReconstructionRecord setup}, PeelChain R → PeelChain R → Prop
  | adjacent_swap
      {R : CompletedReconstructionRecord setup} {s t : Fin R.n}
      (h : IndependentSinks R s t)
      (hSinkS : R.IsSink s) (hSinkT : R.IsSink t)
      (tail₁ : PeelChain
        (peelSink (peelSink R s) (peelSinkOtherIdx s t (Ne.symm h.s_ne_t))))
      (tail₂ : PeelChain
        (peelSink (peelSink R t) (peelSinkOtherIdx t s h.s_ne_t))) :
      AdminMove
        (.cons R s hSinkS
          (.cons (peelSink R s) (peelSinkOtherIdx s t (Ne.symm h.s_ne_t))
            (peelSinkOtherIdx_isSink s t (Ne.symm h.s_ne_t) hSinkT) tail₁))
        (.cons R t hSinkT
          (.cons (peelSink R t) (peelSinkOtherIdx t s h.s_ne_t)
            (peelSinkOtherIdx_isSink t s h.s_ne_t hSinkS) tail₂))

namespace AdminMove

/-- **Frontier theorem (the non-vacuity gate, per
`INV AdminMove-Nonvacuity`).** The two-step residues of an
`adjacent_swap` move are `RecordStructEquiv BoundaryAdminEquiv`.

This theorem **directly consumes** `peelSink_swap_structEquiv_admin`
at the swap frontier — it does *not* route through any replay/inverse
construction, and is not vacuously derivable from `replay_stable`. -/
theorem frontier_structEquiv_admin
    {R : CompletedReconstructionRecord setup} {s t : Fin R.n}
    (h : IndependentSinks R s t) :
    RecordStructEquiv (@BoundaryAdminEquiv setup)
      (peelSink (peelSink R s) (peelSinkOtherIdx s t (Ne.symm h.s_ne_t)))
      (peelSink (peelSink R t) (peelSinkOtherIdx t s h.s_ne_t)) :=
  peelSink_swap_structEquiv_admin h

end AdminMove

/-! ### Generated chain-level administrative equivalence -/

/-- **Chain-level administrative equivalence.**

The free equivalence relation generated by `AdminMove`. This is the
intended `BR`-analogue at the *chain level* for downstream global
canonicality: two chains over the same record are admin-equivalent
when they differ by a finite sequence of head-prefix adjacent swaps,
closed under `refl`/`symm`/`trans`.

Per `INV AdminMove-Nonvacuity`: any consumer of `AdminEquiv` for
non-vacuous structural conclusions must descend through `ofMove` to
reach `frontier_structEquiv_admin`. -/
inductive AdminEquiv :
    ∀ {R : CompletedReconstructionRecord setup}, PeelChain R → PeelChain R → Prop
  | refl {R : CompletedReconstructionRecord setup} (c : PeelChain R) :
      AdminEquiv c c
  | symm {R : CompletedReconstructionRecord setup} {c₁ c₂ : PeelChain R} :
      AdminEquiv c₁ c₂ → AdminEquiv c₂ c₁
  | trans {R : CompletedReconstructionRecord setup} {c₁ c₂ c₃ : PeelChain R} :
      AdminEquiv c₁ c₂ → AdminEquiv c₂ c₃ → AdminEquiv c₁ c₃
  | ofMove {R : CompletedReconstructionRecord setup} {c₁ c₂ : PeelChain R} :
      AdminMove c₁ c₂ → AdminEquiv c₁ c₂

namespace AdminEquiv

/-- Reflexivity (alias of the `refl` constructor for symmetry of API). -/
theorem refl' {R : CompletedReconstructionRecord setup} (c : PeelChain R) :
    AdminEquiv c c := AdminEquiv.refl c

/-- Symmetry (alias of the `symm` constructor). -/
theorem symm' {R : CompletedReconstructionRecord setup} {c₁ c₂ : PeelChain R}
    (h : AdminEquiv c₁ c₂) : AdminEquiv c₂ c₁ := h.symm

/-- Transitivity (alias of the `trans` constructor). -/
theorem trans' {R : CompletedReconstructionRecord setup}
    {c₁ c₂ c₃ : PeelChain R}
    (h₁ : AdminEquiv c₁ c₂) (h₂ : AdminEquiv c₂ c₃) :
    AdminEquiv c₁ c₃ := h₁.trans h₂

/-- The single-move embedding (alias of the `ofMove` constructor). -/
theorem ofMove' {R : CompletedReconstructionRecord setup}
    {c₁ c₂ : PeelChain R} (h : AdminMove c₁ c₂) : AdminEquiv c₁ c₂ :=
  AdminEquiv.ofMove h

end AdminEquiv

end PeelChain

