import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.LocalizationInput.WordQuotient.Category.InvertedInputs.Owner

/-!
# Named inverted localization-input families

This file names the categorical isomorphisms generated by the concrete
localization-input constructors: descent, interval-homotopy, and Tate
stabilization.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The localized-word isomorphism generated by a descent-channel input. -/
def TraceLocalizationInput.descentChannelIso
    (source target : QTraceExpression) :
    CategoryTheory.Iso
      (TraceLocalizedWordObject.ofTraceObject
        (TraceLocalizationInput.descentChannel source target).sourceObject)
      (TraceLocalizedWordObject.ofTraceObject
        (TraceLocalizationInput.descentChannel source target).targetObject) :=
  (TraceLocalizationInput.descentChannel source target).localizedWordIso

