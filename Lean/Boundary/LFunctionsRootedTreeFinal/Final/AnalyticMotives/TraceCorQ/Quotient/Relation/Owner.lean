import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.TraceCorQ.Quotient.RelationWitness.Owner

/-!
# Witness-generated quotient relation

This file owns the genuine relation on raw quotient candidates generated by
finite relation witnesses.

The relation is proof-relevant only through its constructor data: a relation
proof is the existence of a concrete finite witness.  All operations here are
thin wrappers around the witness constructors.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The relation on quotient candidates generated by finite relation witnesses. -/
abbrev TraceCorQQuotientRelation
    (left right : TraceCorQQuotientCandidate) :=
  Nonempty (TraceCorQRelationWitness left right)

/-- Build a quotient relation proof from a finite relation witness. -/
def TraceCorQQuotientRelation.ofWitness
    {left right : TraceCorQQuotientCandidate}
    (witness : TraceCorQRelationWitness left right) :
    TraceCorQQuotientRelation left right :=
  Nonempty.intro witness

/-- Reflexivity of the witness-generated quotient relation. -/
def TraceCorQQuotientRelation.refl
    (candidate : TraceCorQQuotientCandidate) :
    TraceCorQQuotientRelation candidate candidate :=
  TraceCorQQuotientRelation.ofWitness
    (TraceCorQRelationWitness.refl candidate)

/-- Symmetry of the witness-generated quotient relation. -/
def TraceCorQQuotientRelation.symm
    {left right : TraceCorQQuotientCandidate}
    (relation : TraceCorQQuotientRelation left right) :
    TraceCorQQuotientRelation right left :=
  match relation with
  | Nonempty.intro witness =>
      TraceCorQQuotientRelation.ofWitness
        (TraceCorQRelationWitness.symm witness)

/-- Transitivity of the witness-generated quotient relation. -/
def TraceCorQQuotientRelation.trans
    {left middle right : TraceCorQQuotientCandidate}
    (first : TraceCorQQuotientRelation left middle)
    (second : TraceCorQQuotientRelation middle right) :
    TraceCorQQuotientRelation left right :=
  match first, second with
  | Nonempty.intro firstWitness, Nonempty.intro secondWitness =>
      TraceCorQQuotientRelation.ofWitness
        (TraceCorQRelationWitness.trans firstWitness secondWitness)

/-- Additive compatibility of the witness-generated quotient relation. -/
def TraceCorQQuotientRelation.addCongr
    {left₁ left₂ right₁ right₂ : TraceCorQQuotientCandidate}
    (leftRelation : TraceCorQQuotientRelation left₁ left₂)
    (rightRelation : TraceCorQQuotientRelation right₁ right₂) :
    TraceCorQQuotientRelation
      (TraceCorQQuotientCandidate.add left₁ right₁)
      (TraceCorQQuotientCandidate.add left₂ right₂) :=
  match leftRelation, rightRelation with
  | Nonempty.intro leftWitness, Nonempty.intro rightWitness =>
      TraceCorQQuotientRelation.ofWitness
        (TraceCorQRelationWitness.addCongr leftWitness rightWitness)

/-- Scalar compatibility of the witness-generated quotient relation. -/
def TraceCorQQuotientRelation.smulCongr
    {left right : TraceCorQQuotientCandidate}
    (coefficient : Rat)
    (relation : TraceCorQQuotientRelation left right) :
    TraceCorQQuotientRelation
      (TraceCorQQuotientCandidate.smul coefficient left)
      (TraceCorQQuotientCandidate.smul coefficient right) :=
  match relation with
  | Nonempty.intro witness =>
      TraceCorQQuotientRelation.ofWitness
        (TraceCorQRelationWitness.smulCongr
          coefficient
          witness)

/-- Composition compatibility of the witness-generated quotient relation. -/
def TraceCorQQuotientRelation.compCongr
    {left₁ left₂ right₁ right₂ : TraceCorQQuotientCandidate}
    (leftRelation : TraceCorQQuotientRelation left₁ left₂)
    (rightRelation : TraceCorQQuotientRelation right₁ right₂) :
    TraceCorQQuotientRelation
      (TraceCorQQuotientCandidate.comp left₁ right₁)
      (TraceCorQQuotientCandidate.comp left₂ right₂) :=
  match leftRelation, rightRelation with
  | Nonempty.intro leftWitness, Nonempty.intro rightWitness =>
      TraceCorQQuotientRelation.ofWitness
        (TraceCorQRelationWitness.compCongr
          leftWitness
          rightWitness)

/-- Same-formal-sum candidates are related, regardless of ledger bookkeeping. -/
def TraceCorQQuotientRelation.sameFormalSum
    (ledger : TraceCorQRelationLedger)
    {left right : TraceCorQQuotientCandidate}
    (formalSum_eq : left.formalSum = right.formalSum) :
    TraceCorQQuotientRelation left right :=
  TraceCorQQuotientRelation.ofWitness
    (TraceCorQRelationWitness.sameFormalSum
      ledger
      formalSum_eq)

/-- Permuted-formal-sum candidates are related, regardless of ledger bookkeeping. -/
def TraceCorQQuotientRelation.permFormalSum
    (ledger : TraceCorQRelationLedger)
    {left right : TraceCorQQuotientCandidate}
    (formalSum_perm : List.Perm left.formalSum right.formalSum) :
    TraceCorQQuotientRelation left right :=
  TraceCorQQuotientRelation.ofWitness
    (TraceCorQRelationWitness.permFormalSum
      ledger
      formalSum_perm)

/-- Adjacent opposite rational multiples of the same generator are related away. -/
def TraceCorQQuotientRelation.cancelAdjacentOpposite
    (ledger : TraceCorQRelationLedger)
    (prefix suffix : TraceCorQFormalSum)
    (coefficient : Rat)
    (generator : TraceCorQGenerator) :
    TraceCorQQuotientRelation
      (TraceCorQQuotientInput.ofFormalSumLedger
        (prefix ++
          (coefficient, generator) ::
            (-coefficient, generator) ::
              suffix)
        ledger)
      (TraceCorQQuotientInput.ofFormalSumLedger
        (prefix ++ suffix)
        ledger) :=
  TraceCorQQuotientRelation.ofWitness
    (TraceCorQRelationWitness.cancelAdjacentOpposite
      ledger
      prefix
      suffix
      coefficient
      generator)

/-- Adjacent rational multiples of the same generator combine. -/
def TraceCorQQuotientRelation.combineAdjacentSame
    (ledger : TraceCorQRelationLedger)
    (prefix suffix : TraceCorQFormalSum)
    (leftCoefficient rightCoefficient : Rat)
    (generator : TraceCorQGenerator) :
    TraceCorQQuotientRelation
      (TraceCorQQuotientInput.ofFormalSumLedger
        (prefix ++
          (leftCoefficient, generator) ::
            (rightCoefficient, generator) ::
              suffix)
        ledger)
      (TraceCorQQuotientInput.ofFormalSumLedger
        (prefix ++
          (leftCoefficient + rightCoefficient, generator) ::
            suffix)
        ledger) :=
  TraceCorQQuotientRelation.ofWitness
    (TraceCorQRelationWitness.combineAdjacentSame
      ledger
      prefix
      suffix
      leftCoefficient
      rightCoefficient
      generator)

/-- Endpoint transport for the witness-generated quotient relation. -/
def TraceCorQQuotientRelation.transportEndpoints
    {sourceLeft sourceRight targetLeft targetRight :
      TraceCorQQuotientCandidate}
    (left_eq : sourceLeft = targetLeft)
    (right_eq : sourceRight = targetRight)
    (relation : TraceCorQQuotientRelation sourceLeft sourceRight) :
    TraceCorQQuotientRelation targetLeft targetRight :=
  match relation with
  | Nonempty.intro witness =>
      TraceCorQQuotientRelation.ofWitness
        (TraceCorQRelationWitness.transportEndpoints
          left_eq
          right_eq
          witness)

end AnalyticMotives
end LFunctions
end Boundary
