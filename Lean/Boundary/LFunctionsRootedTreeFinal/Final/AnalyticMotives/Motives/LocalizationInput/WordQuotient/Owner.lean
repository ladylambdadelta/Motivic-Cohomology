import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.LocalizationInput.ReductionClosure.Owner

/-!
# Quotient classes of formal localization words

This file owns the quotient of formal localization words by the generated
localization-word relation.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The setoid on formal localization words generated by reduction closure. -/
def TraceLocalizationWordSetoid
    (source target : TraceCorQObject) :
    Setoid (TraceLocalizationWord source target) where
  r := fun left right =>
    Nonempty (TraceLocalizationWordRelation left right)
  iseqv := {
    refl := fun word =>
      Nonempty.intro
        (TraceLocalizationWordRelation.refl word)
    symm := fun relation =>
      match relation with
      | Nonempty.intro witness =>
          Nonempty.intro
            (TraceLocalizationWordRelation.symm witness)
    trans := fun first second =>
      match first with
      | Nonempty.intro firstWitness =>
          match second with
          | Nonempty.intro secondWitness =>
              Nonempty.intro
                (TraceLocalizationWordRelation.trans
                  firstWitness
                  secondWitness)
  }

/-- A formal localized word class from source to target. -/
abbrev TraceLocalizationWordClass
    (source target : TraceCorQObject) :=
  Quotient (TraceLocalizationWordSetoid source target)

/-- The quotient class represented by a formal localization word. -/
def TraceLocalizationWordClass.ofWord
    {source target : TraceCorQObject}
    (word : TraceLocalizationWord source target) :
    TraceLocalizationWordClass source target :=
  Quotient.mk (TraceLocalizationWordSetoid source target) word

/-- A represented word class remembers its chosen representative before quotienting. -/
theorem TraceLocalizationWordClass.ofWord_eq_mk
    {source target : TraceCorQObject}
    (word : TraceLocalizationWord source target) :
    TraceLocalizationWordClass.ofWord word =
      Quotient.mk (TraceLocalizationWordSetoid source target) word :=
  rfl

/-- The identity formal localized word class. -/
def TraceLocalizationWordClass.identity
    (object : TraceCorQObject) :
    TraceLocalizationWordClass object object :=
  TraceLocalizationWordClass.ofWord
    (TraceLocalizationWord.identity object)

/-- The identity word-class representative has no atoms. -/
theorem TraceLocalizationWordClass.identity_representative_atomCount
    (object : TraceCorQObject) :
    (TraceLocalizationWord.identity object).atomCount =
      0 :=
  rfl

/-- The one-forward-input formal localized word class. -/
def TraceLocalizationWordClass.ofInputForward
    (input : TraceLocalizationInput) :
    TraceLocalizationWordClass input.sourceObject input.targetObject :=
  TraceLocalizationWordClass.ofWord
    (TraceLocalizationWord.ofInputForward input)

/-- The forward-input word-class representative has one atom. -/
theorem TraceLocalizationWordClass.ofInputForward_representative_atomCount
    (input : TraceLocalizationInput) :
    (TraceLocalizationWord.ofInputForward input).atomCount =
      0 + 1 :=
  rfl

/-- The one-inverse-input formal localized word class. -/
def TraceLocalizationWordClass.ofInputInverse
    (input : TraceLocalizationInput) :
    TraceLocalizationWordClass input.targetObject input.sourceObject :=
  TraceLocalizationWordClass.ofWord
    (TraceLocalizationWord.ofInputInverse input)

/-- The inverse-input word-class representative has one atom. -/
theorem TraceLocalizationWordClass.ofInputInverse_representative_atomCount
    (input : TraceLocalizationInput) :
    (TraceLocalizationWord.ofInputInverse input).atomCount =
      0 + 1 :=
  rfl

/-- A generated word relation gives equality of word classes. -/
theorem TraceLocalizationWordClass.sound
    {source target : TraceCorQObject}
    {left right : TraceLocalizationWord source target}
    (relation : TraceLocalizationWordRelation left right) :
    TraceLocalizationWordClass.ofWord left =
      TraceLocalizationWordClass.ofWord right :=
  Quotient.sound (Nonempty.intro relation)

/-- Forward followed by inverse is equal to identity in word classes. -/
theorem TraceLocalizationWordClass.forward_inverse_eq_identity
    (input : TraceLocalizationInput) :
    TraceLocalizationWordClass.ofWord
        (TraceLocalizationWord.forwardThenInverse input) =
      TraceLocalizationWordClass.identity input.sourceObject :=
  TraceLocalizationWordClass.sound
    (TraceLocalizationWordRelation.forwardInverse input)

/-- Inverse followed by forward is equal to identity in word classes. -/
theorem TraceLocalizationWordClass.inverse_forward_eq_identity
    (input : TraceLocalizationInput) :
    TraceLocalizationWordClass.ofWord
        (TraceLocalizationWord.inverseThenForward input) =
      TraceLocalizationWordClass.identity input.targetObject :=
  TraceLocalizationWordClass.sound
    (TraceLocalizationWordRelation.inverseForward input)

end AnalyticMotives
end LFunctions
end Boundary
