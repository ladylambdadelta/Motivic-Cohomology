import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Presheaves.RewriteMaps.Owner

/-!
# Motive-root rewrite-map wrappers

This file exposes the concrete presheaf maps generated by one-step analytic
trace rewrites at the motive root.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The motive root exposes the source presentation of a one-step rewrite generator. -/
def TraceAnalyticMotive.rewriteSourcePresentation
    (generator : TraceRewriteGenerator) :
    CertifiedResidueChannelPresentation :=
  generator.sourcePresentation

/-- The motive root exposes the target presentation of a one-step rewrite generator. -/
def TraceAnalyticMotive.rewriteTargetPresentation
    (generator : TraceRewriteGenerator) :
    CertifiedResidueChannelPresentation :=
  generator.targetPresentation

/-- The motive root exposes the source object of a one-step rewrite generator. -/
def TraceAnalyticMotive.rewriteSourceObject
    (generator : TraceRewriteGenerator) :
    TraceCorQObject :=
  generator.sourceObject

/-- The source object is the source certified presentation. -/
theorem TraceAnalyticMotive.rewriteSourceObject_eq_sourcePresentation
    (generator : TraceRewriteGenerator) :
    TraceAnalyticMotive.rewriteSourceObject generator =
      TraceAnalyticMotive.rewriteSourcePresentation generator :=
  rfl

/-- The motive root exposes the target object of a one-step rewrite generator. -/
def TraceAnalyticMotive.rewriteTargetObject
    (generator : TraceRewriteGenerator) :
    TraceCorQObject :=
  generator.targetObject

/-- The target object is the target certified presentation. -/
theorem TraceAnalyticMotive.rewriteTargetObject_eq_targetPresentation
    (generator : TraceRewriteGenerator) :
    TraceAnalyticMotive.rewriteTargetObject generator =
      TraceAnalyticMotive.rewriteTargetPresentation generator :=
  rfl

/-- The motive root exposes the trace transport carried by a rewrite generator. -/
def TraceAnalyticMotive.rewriteTransport
    (generator : TraceRewriteGenerator) :
    TraceTransport :=
  generator.transport

/-- The rewrite transport starts at the rewrite source object. -/
theorem TraceAnalyticMotive.rewriteTransport_source
    (generator : TraceRewriteGenerator) :
    (TraceAnalyticMotive.rewriteTransport generator).source =
      TraceAnalyticMotive.rewriteSourceObject generator :=
  TraceRewriteGenerator.transport_source
    generator

/-- The rewrite transport ends at the rewrite target object. -/
theorem TraceAnalyticMotive.rewriteTransport_target
    (generator : TraceRewriteGenerator) :
    (TraceAnalyticMotive.rewriteTransport generator).target =
      TraceAnalyticMotive.rewriteTargetObject generator :=
  TraceRewriteGenerator.transport_target
    generator

/-- The rewrite transport path is the one-step path of the generator. -/
theorem TraceAnalyticMotive.rewriteTransport_path
    (generator : TraceRewriteGenerator) :
    (TraceAnalyticMotive.rewriteTransport generator).path =
      TraceRewritePath.ofGenerator generator :=
  TraceRewriteGenerator.transport_path
    generator

/-- The motive root exposes the trace hom generated by a one-step rewrite. -/
def TraceAnalyticMotive.rewriteTraceHom
    (generator : TraceRewriteGenerator) :
    TraceAnalyticMotive.rewriteSourceObject generator ⟶
      TraceAnalyticMotive.rewriteTargetObject generator :=
  generator.traceHom

/-- The motive root exposes the representable presheaf map generated by a rewrite. -/
def TraceAnalyticMotive.rewriteRepresentableMap
    (generator : TraceRewriteGenerator) :
    TraceCorQPresheafHom
      (TraceCorQPresheaf.representable
        (TraceAnalyticMotive.rewriteSourceObject generator))
      (TraceCorQPresheaf.representable
        (TraceAnalyticMotive.rewriteTargetObject generator)) :=
  generator.representableMap

/-- The motive root exposes the lifted representable-subcategory map generated by a rewrite. -/
def TraceAnalyticMotive.rewriteRepresentableSubcategoryMap
    (generator : TraceRewriteGenerator) :
    (TraceCorQRepresentablePresheaf.yoneda).obj
        (TraceAnalyticMotive.rewriteSourceObject generator) ⟶
      (TraceCorQRepresentablePresheaf.yoneda).obj
        (TraceAnalyticMotive.rewriteTargetObject generator) :=
  generator.representableSubcategoryMap

/-- Forgetting the lifted rewrite map gives the ambient representable map. -/
theorem TraceAnalyticMotive.rewriteRepresentableSubcategoryMap_inclusion
    (generator : TraceRewriteGenerator) :
    TraceCorQRepresentablePresheaf.inclusion.map
        (TraceAnalyticMotive.rewriteRepresentableSubcategoryMap generator) =
      TraceAnalyticMotive.rewriteRepresentableMap generator :=
  TraceRewriteGenerator.representableSubcategoryMap_inclusion
    generator

/-- The representable-map preimage is the trace hom generated by the rewrite. -/
theorem TraceAnalyticMotive.rewriteRepresentableMap_preimage
    (generator : TraceRewriteGenerator) :
    TraceCorQPresheaf.representablePreimage
        (TraceAnalyticMotive.rewriteRepresentableMap generator) =
      TraceAnalyticMotive.rewriteTraceHom generator :=
  TraceRewriteGenerator.representableMap_preimage
    generator

/-- The lifted representable-subcategory preimage is the rewrite trace hom. -/
theorem TraceAnalyticMotive.rewriteRepresentableSubcategoryMap_preimage
    (generator : TraceRewriteGenerator) :
    TraceCorQRepresentablePresheaf.yonedaPreimage
        (TraceAnalyticMotive.rewriteRepresentableSubcategoryMap generator) =
      TraceAnalyticMotive.rewriteTraceHom generator :=
  TraceRewriteGenerator.representableSubcategoryMap_preimage
    generator

end AnalyticMotives
end LFunctions
end Boundary
