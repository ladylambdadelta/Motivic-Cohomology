/-- The trace-correspondence root exposes the singleton-ledger closure generated by a relation generator. -/
def TraceCorQ.relationGenerator_supportClosure
    (relation : TraceCorQRelationGenerator) :
    TraceCorQRelationClosure
      (TraceCorQRelationLedger.singleton relation)
      (TraceCorQRelationGenerator.supportCandidate relation)
      TraceCorQQuotientCandidate.empty :=
  TraceCorQRelationGenerator.supportClosure
    relation

/-- The trace-correspondence root exposes the closure as a transported primitive step. -/
theorem TraceCorQ.relationGenerator_supportClosure_eq_transport_step
    (relation : TraceCorQRelationGenerator) :
    TraceCorQRelationGenerator.supportClosure relation =
      TraceCorQRelationClosure.transportLedger
        (TraceCorQRelationLedger.append_empty
          (TraceCorQRelationLedger.singleton relation))
        (TraceCorQRelationClosure.stepDerivation
          TraceCorQRelationLedger.empty
          relation) :=
  TraceCorQRelationGenerator.supportClosure_eq_transport_step
    relation

/-- The trace-correspondence root exposes the canonical support witness generated by a relation generator. -/
def TraceCorQ.relationGenerator_supportWitness
    (relation : TraceCorQRelationGenerator) :
    TraceCorQRelationWitness
      (TraceCorQRelationGenerator.supportCandidate relation)
      TraceCorQQuotientCandidate.empty :=
  TraceCorQRelationGenerator.supportWitness
    relation

/-- The trace-correspondence root exposes the support witness as a ledger derivation. -/
theorem TraceCorQ.relationGenerator_supportWitness_eq_ofClosure
    (relation : TraceCorQRelationGenerator) :
    TraceCorQRelationGenerator.supportWitness relation =
      TraceCorQRelationWitness.ofLedgerDerivation
        (TraceCorQRelationLedger.singleton relation)
        (TraceCorQRelationGenerator.supportClosure relation) :=
  TraceCorQRelationGenerator.supportWitness_eq_ofClosure
    relation

/-- The trace-correspondence root exposes support-witness singleton ledgers. -/
theorem TraceCorQ.relationGenerator_supportWitness_ledger
    (relation : TraceCorQRelationGenerator) :
    (TraceCorQRelationGenerator.supportWitness relation).ledger =
      TraceCorQRelationLedger.singleton relation :=
  TraceCorQRelationGenerator.supportWitness_ledger
    relation

