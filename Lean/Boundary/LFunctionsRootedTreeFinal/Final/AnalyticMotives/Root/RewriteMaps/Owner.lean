import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Root.RewriteMaps.Owner

/-!
# Top-root rewrite-map wrappers

This file exposes the concrete presheaf maps generated by one-step analytic
trace rewrites under the top-level `AnalyticMotivesRoot` namespace.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The top root exposes the source presentation of a one-step rewrite generator. -/
def AnalyticMotivesRoot.rewriteSourcePresentation
    (generator : TraceRewriteGenerator) :
    CertifiedResidueChannelPresentation :=
  TraceAnalyticMotive.rewriteSourcePresentation generator

/-- The top root exposes the target presentation of a one-step rewrite generator. -/
def AnalyticMotivesRoot.rewriteTargetPresentation
    (generator : TraceRewriteGenerator) :
    CertifiedResidueChannelPresentation :=
  TraceAnalyticMotive.rewriteTargetPresentation generator

/-- The top root exposes the source object of a one-step rewrite generator. -/
def AnalyticMotivesRoot.rewriteSourceObject
    (generator : TraceRewriteGenerator) :
    TraceCorQObject :=
  TraceAnalyticMotive.rewriteSourceObject generator

/-- The top-root source object is the top-root source certified presentation. -/
theorem AnalyticMotivesRoot.rewriteSourceObject_eq_sourcePresentation
    (generator : TraceRewriteGenerator) :
    AnalyticMotivesRoot.rewriteSourceObject generator =
      AnalyticMotivesRoot.rewriteSourcePresentation generator :=
  TraceAnalyticMotive.rewriteSourceObject_eq_sourcePresentation
    generator

/-- The top root exposes the target object of a one-step rewrite generator. -/
def AnalyticMotivesRoot.rewriteTargetObject
    (generator : TraceRewriteGenerator) :
    TraceCorQObject :=
  TraceAnalyticMotive.rewriteTargetObject generator

/-- The top-root target object is the top-root target certified presentation. -/
theorem AnalyticMotivesRoot.rewriteTargetObject_eq_targetPresentation
    (generator : TraceRewriteGenerator) :
    AnalyticMotivesRoot.rewriteTargetObject generator =
      AnalyticMotivesRoot.rewriteTargetPresentation generator :=
  TraceAnalyticMotive.rewriteTargetObject_eq_targetPresentation
    generator

/-- The top root exposes the trace transport carried by a rewrite generator. -/
def AnalyticMotivesRoot.rewriteTransport
    (generator : TraceRewriteGenerator) :
    TraceTransport :=
  TraceAnalyticMotive.rewriteTransport generator

/-- The rewrite transport starts at the rewrite source object. -/
theorem AnalyticMotivesRoot.rewriteTransport_source
    (generator : TraceRewriteGenerator) :
    (AnalyticMotivesRoot.rewriteTransport generator).source =
      AnalyticMotivesRoot.rewriteSourceObject generator :=
  TraceAnalyticMotive.rewriteTransport_source
    generator

/-- The rewrite transport ends at the rewrite target object. -/
theorem AnalyticMotivesRoot.rewriteTransport_target
    (generator : TraceRewriteGenerator) :
    (AnalyticMotivesRoot.rewriteTransport generator).target =
      AnalyticMotivesRoot.rewriteTargetObject generator :=
  TraceAnalyticMotive.rewriteTransport_target
    generator

/-- The rewrite transport path is the one-step path of the generator. -/
theorem AnalyticMotivesRoot.rewriteTransport_path
    (generator : TraceRewriteGenerator) :
    (AnalyticMotivesRoot.rewriteTransport generator).path =
      TraceRewritePath.ofGenerator generator :=
  TraceAnalyticMotive.rewriteTransport_path
    generator

/-- The top root exposes the trace hom generated by a one-step rewrite. -/
def AnalyticMotivesRoot.rewriteTraceHom
    (generator : TraceRewriteGenerator) :
    AnalyticMotivesRoot.rewriteSourceObject generator ⟶
      AnalyticMotivesRoot.rewriteTargetObject generator :=
  TraceAnalyticMotive.rewriteTraceHom generator

/-- The top root exposes the representable presheaf map generated by a rewrite. -/
def AnalyticMotivesRoot.rewriteRepresentableMap
    (generator : TraceRewriteGenerator) :
    TraceCorQPresheafHom
      (TraceCorQPresheaf.representable
        (AnalyticMotivesRoot.rewriteSourceObject generator))
      (TraceCorQPresheaf.representable
        (AnalyticMotivesRoot.rewriteTargetObject generator)) :=
  TraceAnalyticMotive.rewriteRepresentableMap generator

/-- The top root exposes the lifted representable-subcategory map generated by a rewrite. -/
def AnalyticMotivesRoot.rewriteRepresentableSubcategoryMap
    (generator : TraceRewriteGenerator) :
    (TraceCorQRepresentablePresheaf.yoneda).obj
        (AnalyticMotivesRoot.rewriteSourceObject generator) ⟶
      (TraceCorQRepresentablePresheaf.yoneda).obj
        (AnalyticMotivesRoot.rewriteTargetObject generator) :=
  TraceAnalyticMotive.rewriteRepresentableSubcategoryMap generator

/-- Forgetting the lifted rewrite map gives the ambient representable map. -/
theorem AnalyticMotivesRoot.rewriteRepresentableSubcategoryMap_inclusion
    (generator : TraceRewriteGenerator) :
    TraceCorQRepresentablePresheaf.inclusion.map
        (AnalyticMotivesRoot.rewriteRepresentableSubcategoryMap generator) =
      AnalyticMotivesRoot.rewriteRepresentableMap generator :=
  TraceAnalyticMotive.rewriteRepresentableSubcategoryMap_inclusion
    generator

/-- The representable-map preimage is the trace hom generated by the rewrite. -/
theorem AnalyticMotivesRoot.rewriteRepresentableMap_preimage
    (generator : TraceRewriteGenerator) :
    TraceCorQPresheaf.representablePreimage
        (AnalyticMotivesRoot.rewriteRepresentableMap generator) =
      AnalyticMotivesRoot.rewriteTraceHom generator :=
  TraceAnalyticMotive.rewriteRepresentableMap_preimage
    generator

/-- The lifted representable-subcategory preimage is the rewrite trace hom. -/
theorem AnalyticMotivesRoot.rewriteRepresentableSubcategoryMap_preimage
    (generator : TraceRewriteGenerator) :
    TraceCorQRepresentablePresheaf.yonedaPreimage
        (AnalyticMotivesRoot.rewriteRepresentableSubcategoryMap generator) =
      AnalyticMotivesRoot.rewriteTraceHom generator :=
  TraceAnalyticMotive.rewriteRepresentableSubcategoryMap_preimage
    generator

end AnalyticMotives
end LFunctions
end Boundary
