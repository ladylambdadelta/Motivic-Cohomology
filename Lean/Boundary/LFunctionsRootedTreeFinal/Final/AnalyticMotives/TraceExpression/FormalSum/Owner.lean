import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.TraceExpression.Atoms.Owner

/-!
# Formal sums of trace expressions

This file owns the free formal additive syntax generated by trace-expression
atoms.  It is the target language for Stokes, residue, channel, refinement,
schedule, and weight-drop rewrites.

The construction should be a concrete formal-expression grammar.  It should
not package an unspecified additive type as an input.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- A finite formal sum of trace atoms before rational coefficients are added. -/
abbrev TraceFormalSum :=
  List TraceAtom

/-- The empty trace formal sum. -/
def TraceFormalSum.zero : TraceFormalSum :=
  []

/-- The singleton trace formal sum generated by one atom. -/
def TraceFormalSum.singleton (atom : TraceAtom) : TraceFormalSum :=
  [atom]

/-- Addition in the free formal additive syntax is list concatenation. -/
def TraceFormalSum.add (left right : TraceFormalSum) : TraceFormalSum :=
  left ++ right

/-- Add one atom at the front of a trace formal sum. -/
def TraceFormalSum.cons (atom : TraceAtom) (sum : TraceFormalSum) : TraceFormalSum :=
  atom :: sum

end AnalyticMotives
end LFunctions
end Boundary
