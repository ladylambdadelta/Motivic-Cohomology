import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Correspondences.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.LinearTransfers.ContourCorQInput.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.LinearTransfers.ContourCorQConstruction.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.LinearTransfers.CorrespondenceCategory.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.LinearTransfers.QLinearization.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.LinearTransfers.PresheafCategory.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Bulk.Presheaves.LinearTransfers.TransferAction.Owner

/-!
# `ℚ`-linear presheaves with contour transfers

This file owns the additive presheaf layer on the correspondence category.  It
is the analytic analogue of presheaves with transfers, with transfer morphisms
generated by contour-compatible analytic correspondences.

Dependency order: constructed `ContourCor_Q` input, correspondence category,
`ℚ`-linearization, presheaf category, then transfer action.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/--
An analytic presheaf with rational contour transfers.  This is the first
presheaf-level object in the analytic motive construction: values on
contour-admissible bulks together with transfer pullbacks along finite rational
linear combinations of contour-compatible correspondences.
-/
structure AnalyticPresheafWithTransfers where
  presheaf : RationalContourPresheaf
  transferAction : RationalContourTransferAction presheaf

namespace AnalyticPresheafWithTransfers

/-- The underlying rational contour presheaf. -/
def underlying (F : AnalyticPresheafWithTransfers) :
    RationalContourPresheaf :=
  F.presheaf

/-- The value of a presheaf with transfers on a contour-admissible bulk. -/
def valueAt (F : AnalyticPresheafWithTransfers)
    (X : ContourCorrespondenceObject) : Type :=
  F.presheaf.value X

/-- Pullback along a rational contour correspondence. -/
def pullbackAlong (F : AnalyticPresheafWithTransfers)
    {X Y : ContourCorrespondenceObject}
    (f : RationalContourHom X Y) :
    F.valueAt Y → F.valueAt X :=
  F.transferAction.act f

end AnalyticPresheafWithTransfers

/--
An analytic presheaf with functorial rational contour transfers.  This package
adds reindexing invariance and identity and composition laws for transfer
pullbacks.
-/
structure FunctorialAnalyticPresheafWithTransfers where
  presheaf : RationalContourPresheaf
  functorialTransfer :
    RationalContourFunctorialTransferAction presheaf

namespace FunctorialAnalyticPresheafWithTransfers

/-- The lightweight presheaf-with-transfers obtained by forgetting functoriality laws. -/
def forget (F : FunctorialAnalyticPresheafWithTransfers) :
    AnalyticPresheafWithTransfers where
  presheaf := F.presheaf
  transferAction := F.functorialTransfer.transferAction

/-- The rational contour category data used by a functorial presheaf with transfers. -/
def categoryData (F : FunctorialAnalyticPresheafWithTransfers) :
    RationalContourCategoryData :=
  F.functorialTransfer.rationalCategory

/-- Reindexing invariance for pullbacks in a functorial presheaf with transfers. -/
theorem reindexing_pullback_eq
    (F : FunctorialAnalyticPresheafWithTransfers)
    {X Y : ContourCorrespondenceObject}
    (f g : RationalContourHom X Y)
    (R : RationalContourCombinationReindexing f g) :
    F.functorialTransfer.transferAction.act f =
      F.functorialTransfer.transferAction.act g :=
  RationalContourFunctorialTransferAction.reindexing_action_eq
    F.functorialTransfer f g R

/-- Left identity law for pullbacks in a functorial presheaf with transfers. -/
theorem left_identity_pullback_eq
    (F : FunctorialAnalyticPresheafWithTransfers)
    {X Y : ContourCorrespondenceObject}
    (f : RationalContourHom X Y) :
    F.functorialTransfer.transferAction.act
        (F.functorialTransfer.rationalCategory.compose
          (F.functorialTransfer.rationalCategory.identity X) f) =
      F.functorialTransfer.transferAction.act f :=
  RationalContourFunctorialTransferAction.left_identity_action_eq
    F.functorialTransfer f

/-- Right identity law for pullbacks in a functorial presheaf with transfers. -/
theorem right_identity_pullback_eq
    (F : FunctorialAnalyticPresheafWithTransfers)
    {X Y : ContourCorrespondenceObject}
    (f : RationalContourHom X Y) :
    F.functorialTransfer.transferAction.act
        (F.functorialTransfer.rationalCategory.compose f
          (F.functorialTransfer.rationalCategory.identity Y)) =
      F.functorialTransfer.transferAction.act f :=
  RationalContourFunctorialTransferAction.right_identity_action_eq
    F.functorialTransfer f

/-- Associativity law for pullbacks in a functorial presheaf with transfers. -/
theorem associativity_pullback_eq
    (F : FunctorialAnalyticPresheafWithTransfers)
    {W X Y Z : ContourCorrespondenceObject}
    (f : RationalContourHom W X)
    (g : RationalContourHom X Y)
    (h : RationalContourHom Y Z) :
    F.functorialTransfer.transferAction.act
        (F.functorialTransfer.rationalCategory.compose
          (F.functorialTransfer.rationalCategory.compose f g) h) =
      F.functorialTransfer.transferAction.act
        (F.functorialTransfer.rationalCategory.compose f
          (F.functorialTransfer.rationalCategory.compose g h)) :=
  RationalContourFunctorialTransferAction.associativity_action_eq
    F.functorialTransfer f g h

end FunctorialAnalyticPresheafWithTransfers

end AnalyticMotives
end LFunctions
end Boundary
