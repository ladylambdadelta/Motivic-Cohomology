import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Presheaves.RewriteMaps.ByKind.Endpoints.Owner

/-!
# By-kind rewrite presheaf maps

This file names the representable presheaf maps and lifted Yoneda-subcategory
maps for the seven primitive analytic rewrite kinds.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The representable map generated by a Stokes cancellation rewrite. -/
def TraceRewriteGenerator.stokesRepresentableMap
    (source target : QTraceExpression) :
    TraceCorQPresheafHom
      (TraceCorQPresheaf.representable
        (TraceRewriteGenerator.stokes source target).sourceObject)
      (TraceCorQPresheaf.representable
        (TraceRewriteGenerator.stokes source target).targetObject) :=
  (TraceRewriteGenerator.stokes source target).representableMap

