import Mathlib.CategoryTheory.Triangulated.Subcategory
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Comparison.Source.Bounded.TriangulatedSubcategory.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Comparison.Source.Bounded.IsoClosure.Shift.Owner
import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Comparison.Source.Bounded.IsoClosure.TriangulatedSubcategory.MappingCone.Owner

/-!
# Degreewise iso-closure bounded predicate as triangulated-subcategory input

This file records the zero and shift fields for the stable source predicate
generated by degreewise iso-closure bounded cochain complexes.
-/

noncomputable section

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

open CategoryTheory
open CategoryTheory.Limits

namespace TraceAnalyticDMgmComparisonSource

/-- The degreewise iso-closure bounded stable source predicate contains a zero
object in the ambient analytic comparison source. -/
theorem degreewiseIsoClosureBoundedStableObject_triangulatedSubcategory_zero' :
    ∃ (zeroObject : TraceAnalyticDMgmComparisonSource)
      (_ : IsZero zeroObject),
      TraceAnalyticDMgmComparisonSource
        .degreewiseIsoClosureBoundedStableObject zeroObject :=
  Exists.elim
    TraceAnalyticDMgmComparisonSource
      .boundedStableObject_triangulatedSubcategory_zero'
    (fun zeroObject zeroData =>
      Exists.elim
        zeroData
        (fun zero_isZero zero_bounded =>
          Exists.intro
            zeroObject
            (Exists.intro
              zero_isZero
              (TraceAnalyticDMgmComparisonSource
                .degreewiseIsoClosureBoundedStableObject_of_boundedStableObject
                  zero_bounded))))

/-- The degreewise iso-closure bounded stable source predicate is closed under
ambient integer shifts. -/
theorem degreewiseIsoClosureBoundedStableObject_triangulatedSubcategory_shift
    (object : TraceAnalyticDMgmComparisonSource)
    (degree : ℤ)
    (membership :
      TraceAnalyticDMgmComparisonSource
        .degreewiseIsoClosureBoundedStableObject object) :
    TraceAnalyticDMgmComparisonSource
      .degreewiseIsoClosureBoundedStableObject
        (object⟦degree⟧) :=
  TraceAnalyticDMgmComparisonSource
    .degreewiseIsoClosureBoundedStableObject_shift
      membership
      degree

end TraceAnalyticDMgmComparisonSource

end AnalyticMotives
end LFunctions
end Boundary
