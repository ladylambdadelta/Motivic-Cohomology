/-- The top root exposes generated support-input formal sums. -/
theorem AnalyticMotivesRoot.traceCorQRelationGenerator_supportQuotientInput_formalSum_eq_support
  (relation : TraceCorQRelationGenerator) :
    (TraceCorQRelationGenerator.supportQuotientInput relation).formalSum =
      relation.support :=
  TraceCorQ.relationGenerator_supportQuotientInput_formalSum_eq_support
    relation

