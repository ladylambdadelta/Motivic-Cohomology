/-! ## Item 9f — Obligation interface for `List.Perm` on `externalOut` -/

/-- **`ExternalOutCodeContract setup`** (item 9f): an obligation
interface for canonical coding of `List setup.RefinedInterface`
modulo `List.Perm`.

Stated against `List.Perm` because that is exactly the equivalence
appearing in the `externalOut_perm` field of
`FrontierWord.BoundaryEquiv` (item 8v). Both `sound` and `complete`
carry **real signatures** — there are no `Prop` placeholders.

This contract is *not* instantiated in this file: it is an
obligation that must be discharged externally (e.g., by giving
`setup.RefinedInterface` a `LinearOrder` and using a sorted
representative as the code, or by extending `RewriteCalculusSetup`
to carry a `RefinedInterface`-multiset key map). -/
structure ExternalOutCodeContract (setup : RewriteCalculusSetup.{u}) where
  /-- The external-output code target type. -/
  ExternalOutCode : Type v
  /-- The external-output code function. -/
  externalOutCode : List setup.RefinedInterface → ExternalOutCode
  /-- Soundness: `List.Perm`-equivalent lists code to the same value. -/
  sound :
    ∀ {ℓ₁ ℓ₂ : List setup.RefinedInterface},
      List.Perm ℓ₁ ℓ₂ → externalOutCode ℓ₁ = externalOutCode ℓ₂
  /-- **Completeness with a real signature**: equal codes imply
  `List.Perm`. -/
  complete :
    ∀ {ℓ₁ ℓ₂ : List setup.RefinedInterface},
      externalOutCode ℓ₁ = externalOutCode ℓ₂ → List.Perm ℓ₁ ℓ₂

@[simp] theorem ExternalOutCodeContract.mk_ExternalOutCode
    (ExternalOutCode : Type v)
    (externalOutCode : List setup.RefinedInterface → ExternalOutCode)
    (sound :
      ∀ {ℓ₁ ℓ₂ : List setup.RefinedInterface},
        List.Perm ℓ₁ ℓ₂ → externalOutCode ℓ₁ = externalOutCode ℓ₂)
    (complete :
      ∀ {ℓ₁ ℓ₂ : List setup.RefinedInterface},
        externalOutCode ℓ₁ = externalOutCode ℓ₂ → List.Perm ℓ₁ ℓ₂) :
    (ExternalOutCodeContract.mk ExternalOutCode externalOutCode sound complete).ExternalOutCode
      = ExternalOutCode :=
  rfl

@[simp] theorem ExternalOutCodeContract.mk_externalOutCode
    (ExternalOutCode : Type v)
    (externalOutCode : List setup.RefinedInterface → ExternalOutCode)
    (sound :
      ∀ {ℓ₁ ℓ₂ : List setup.RefinedInterface},
        List.Perm ℓ₁ ℓ₂ → externalOutCode ℓ₁ = externalOutCode ℓ₂)
    (complete :
      ∀ {ℓ₁ ℓ₂ : List setup.RefinedInterface},
        externalOutCode ℓ₁ = externalOutCode ℓ₂ → List.Perm ℓ₁ ℓ₂) :
    (ExternalOutCodeContract.mk ExternalOutCode externalOutCode sound complete).externalOutCode
      = externalOutCode :=
  rfl

theorem ExternalOutCodeContract.code_eq_of_perm
    (E : ExternalOutCodeContract.{u, v} setup)
    {ℓ₁ ℓ₂ : List setup.RefinedInterface}
    (h : List.Perm ℓ₁ ℓ₂) :
    E.externalOutCode ℓ₁ = E.externalOutCode ℓ₂ :=
  E.sound h

theorem ExternalOutCodeContract.perm_of_code_eq
    (E : ExternalOutCodeContract.{u, v} setup)
    {ℓ₁ ℓ₂ : List setup.RefinedInterface}
    (h : E.externalOutCode ℓ₁ = E.externalOutCode ℓ₂) :
    List.Perm ℓ₁ ℓ₂ :=
  E.complete h

theorem ExternalOutCodeContract.code_eq_iff_perm
    (E : ExternalOutCodeContract.{u, v} setup)
    {ℓ₁ ℓ₂ : List setup.RefinedInterface} :
    E.externalOutCode ℓ₁ = E.externalOutCode ℓ₂ ↔ List.Perm ℓ₁ ℓ₂ := by
  constructor
  · exact E.perm_of_code_eq
  · exact E.code_eq_of_perm

/-! ## Item 9g — Obligation interface for `BoundaryAdminEquiv` -/

/-- **`BoundaryAdminCodeContract setup`** (item 9g): an obligation
interface for canonical coding of `setup.BoundaryObject` modulo
`BoundaryAdminEquiv`.

Stated against `BoundaryAdminEquiv` because that is exactly the
relation appearing in the `Y_rel` field of
`FrontierWord.BoundaryEquiv` (item 8v). Both `sound` and `complete`
carry **real signatures**.

This contract is *not* instantiated in this file: there is no
serialization map for the opaque `setup.BoundaryObject`, and
`BoundaryAdminEquiv` (generated by `BoundaryTwoStepSwap`) does not
in general reduce to equality. Instantiation is the substantive
mathematical content of the residue-level holographic theorem. -/
structure BoundaryAdminCodeContract (setup : RewriteCalculusSetup.{u}) where
  /-- The admin-boundary code target type. -/
  AdminBoundaryCode : Type v
  /-- The admin-boundary code function. -/
  adminBoundaryCode : setup.BoundaryObject → AdminBoundaryCode
  /-- Soundness: `BoundaryAdminEquiv`-related boundaries code to the
  same value. -/
  sound :
    ∀ {Y₁ Y₂ : setup.BoundaryObject},
      BoundaryAdminEquiv Y₁ Y₂ → adminBoundaryCode Y₁ = adminBoundaryCode Y₂
  /-- **Completeness with a real signature**: equal admin-boundary
  codes imply `BoundaryAdminEquiv`. -/
  complete :
    ∀ {Y₁ Y₂ : setup.BoundaryObject},
      adminBoundaryCode Y₁ = adminBoundaryCode Y₂ → BoundaryAdminEquiv Y₁ Y₂

@[simp] theorem BoundaryAdminCodeContract.mk_AdminBoundaryCode
    (AdminBoundaryCode : Type v)
    (adminBoundaryCode : setup.BoundaryObject → AdminBoundaryCode)
    (sound :
      ∀ {Y₁ Y₂ : setup.BoundaryObject},
        BoundaryAdminEquiv Y₁ Y₂ → adminBoundaryCode Y₁ = adminBoundaryCode Y₂)
    (complete :
      ∀ {Y₁ Y₂ : setup.BoundaryObject},
        adminBoundaryCode Y₁ = adminBoundaryCode Y₂ → BoundaryAdminEquiv Y₁ Y₂) :
    (BoundaryAdminCodeContract.mk AdminBoundaryCode adminBoundaryCode sound complete).AdminBoundaryCode
      = AdminBoundaryCode :=
  rfl

@[simp] theorem BoundaryAdminCodeContract.mk_adminBoundaryCode
    (AdminBoundaryCode : Type v)
    (adminBoundaryCode : setup.BoundaryObject → AdminBoundaryCode)
    (sound :
      ∀ {Y₁ Y₂ : setup.BoundaryObject},
        BoundaryAdminEquiv Y₁ Y₂ → adminBoundaryCode Y₁ = adminBoundaryCode Y₂)
    (complete :
      ∀ {Y₁ Y₂ : setup.BoundaryObject},
        adminBoundaryCode Y₁ = adminBoundaryCode Y₂ → BoundaryAdminEquiv Y₁ Y₂) :
    (BoundaryAdminCodeContract.mk AdminBoundaryCode adminBoundaryCode sound complete).adminBoundaryCode
      = adminBoundaryCode :=
  rfl

theorem BoundaryAdminCodeContract.code_eq_of_equiv
    (A : BoundaryAdminCodeContract.{u, v} setup)
    {Y₁ Y₂ : setup.BoundaryObject}
    (h : BoundaryAdminEquiv Y₁ Y₂) :
    A.adminBoundaryCode Y₁ = A.adminBoundaryCode Y₂ :=
  A.sound h

theorem BoundaryAdminCodeContract.equiv_of_code_eq
    (A : BoundaryAdminCodeContract.{u, v} setup)
    {Y₁ Y₂ : setup.BoundaryObject}
    (h : A.adminBoundaryCode Y₁ = A.adminBoundaryCode Y₂) :
    BoundaryAdminEquiv Y₁ Y₂ :=
  A.complete h

theorem BoundaryAdminCodeContract.code_eq_iff_equiv
    (A : BoundaryAdminCodeContract.{u, v} setup)
    {Y₁ Y₂ : setup.BoundaryObject} :
    A.adminBoundaryCode Y₁ = A.adminBoundaryCode Y₂ ↔ BoundaryAdminEquiv Y₁ Y₂ := by
  constructor
  · exact A.equiv_of_code_eq
  · exact A.code_eq_of_equiv

/-! ## Item 9h — Assemble `BoundaryCodeContract` from subcontracts -/

/-- **Item 9h**: an admin-boundary code contract and an
external-output code contract together assemble into a
`BoundaryCodeContract` for `FrontierWord.BoundaryEquiv` (item 8x).

The boundary-code target is the product
`AdminBoundaryCode × ExternalOutCode`. The proof structure exactly
mirrors the interior-side assembly (item 8y) and the
component-codes assembly (item 8y, top-level):

* `sound`: project a `BoundaryEquiv` into `Y_rel` and
  `externalOut_perm`, then apply per-component soundness and
  package via `Prod.mk.injEq`.
* `complete`: project the product equality via
  `congrArg Prod.fst/snd`, then apply per-component completeness
  to obtain `Y_rel` and `externalOut_perm`, then reassemble. -/
def boundary_component_codes_to_contract
    (A : BoundaryAdminCodeContract.{u, v} setup)
    (E : ExternalOutCodeContract.{u, v} setup) :
    BoundaryCodeContract.{u, v} setup where
  BoundaryCode := A.AdminBoundaryCode × E.ExternalOutCode
  boundaryCode w :=
    (A.adminBoundaryCode w.residue.Y,
      E.externalOutCode w.residue.ports.externalOut)
  sound h := by
    exact Prod.mk.injEq .. |>.mpr ⟨A.sound h.Y_rel, E.sound h.externalOut_perm⟩
  complete h := by
    have hY : A.adminBoundaryCode _ = A.adminBoundaryCode _ :=
      congrArg Prod.fst h
    have hO : E.externalOutCode _ = E.externalOutCode _ :=
      congrArg Prod.snd h
    exact { Y_rel := A.complete hY, externalOut_perm := E.complete hO }

@[simp] theorem boundary_component_codes_to_contract_BoundaryCode
    (A : BoundaryAdminCodeContract.{u, v} setup)
    (E : ExternalOutCodeContract.{u, v} setup) :
    (boundary_component_codes_to_contract A E).BoundaryCode =
      (A.AdminBoundaryCode × E.ExternalOutCode) :=
  rfl

/-- **Audit theorem (9h.b)**: the boundary-component-codes
assembly's `boundaryCode` is the obvious pair. -/
@[simp] theorem boundary_component_codes_to_contract_boundaryCode
    (A : BoundaryAdminCodeContract.{u, v} setup)
    (E : ExternalOutCodeContract.{u, v} setup)
    (w : FrontierWord setup) :
    (boundary_component_codes_to_contract A E).boundaryCode w
      = (A.adminBoundaryCode w.residue.Y,
          E.externalOutCode w.residue.ports.externalOut) :=
  rfl

theorem boundary_component_codes_to_contract_code_eq_of_boundaryEquiv
    (A : BoundaryAdminCodeContract.{u, v} setup)
    (E : ExternalOutCodeContract.{u, v} setup)
    {w₁ w₂ : FrontierWord setup}
    (h : FrontierWord.BoundaryEquiv w₁ w₂) :
    (boundary_component_codes_to_contract A E).boundaryCode w₁ =
      (boundary_component_codes_to_contract A E).boundaryCode w₂ :=
  (boundary_component_codes_to_contract A E).sound h

theorem boundary_component_codes_to_contract_boundaryEquiv_of_code_eq
    (A : BoundaryAdminCodeContract.{u, v} setup)
    (E : ExternalOutCodeContract.{u, v} setup)
    {w₁ w₂ : FrontierWord setup}
    (h : (boundary_component_codes_to_contract A E).boundaryCode w₁ =
      (boundary_component_codes_to_contract A E).boundaryCode w₂) :
    FrontierWord.BoundaryEquiv w₁ w₂ :=
  (boundary_component_codes_to_contract A E).complete h

theorem boundary_component_codes_to_contract_boundaryCode_eq_iff_equiv
    (A : BoundaryAdminCodeContract.{u, v} setup)
    (E : ExternalOutCodeContract.{u, v} setup)
    {w₁ w₂ : FrontierWord setup} :
    (boundary_component_codes_to_contract A E).boundaryCode w₁ =
        (boundary_component_codes_to_contract A E).boundaryCode w₂ ↔
      FrontierWord.BoundaryEquiv w₁ w₂ := by
  constructor
  · exact boundary_component_codes_to_contract_boundaryEquiv_of_code_eq A E
  · exact boundary_component_codes_to_contract_code_eq_of_boundaryEquiv A E

