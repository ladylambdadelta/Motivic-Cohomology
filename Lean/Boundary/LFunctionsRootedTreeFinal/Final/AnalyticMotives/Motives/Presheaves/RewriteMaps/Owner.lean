import Boundary.LFunctionsRootedTreeFinal.Final.AnalyticMotives.Motives.Presheaves.Linear.Owner

/-!
# Presheaf maps generated by analytic rewrites

This file owns the concrete map of representable trace presheaves generated by
a one-step analytic trace rewrite.
-/

namespace Boundary
namespace LFunctions
namespace AnalyticMotives

/-- The source certified presentation attached to a one-step analytic rewrite. -/
def TraceRewriteGenerator.sourcePresentation
    (generator : TraceRewriteGenerator) :
    CertifiedResidueChannelPresentation :=
  CertifiedResidueChannelPresentation.ofSource generator.source

/-- The target certified presentation attached to a one-step analytic rewrite. -/
def TraceRewriteGenerator.targetPresentation
    (generator : TraceRewriteGenerator) :
    CertifiedResidueChannelPresentation :=
  CertifiedResidueChannelPresentation.ofSource generator.target

/-- The source trace-correspondence object attached to a one-step analytic rewrite. -/
def TraceRewriteGenerator.sourceObject
    (generator : TraceRewriteGenerator) :
    TraceCorQObject :=
  generator.sourcePresentation

/-- The target trace-correspondence object attached to a one-step analytic rewrite. -/
def TraceRewriteGenerator.targetObject
    (generator : TraceRewriteGenerator) :
    TraceCorQObject :=
  generator.targetPresentation

/-- The one-step trace transport carried by an analytic rewrite generator. -/
def TraceRewriteGenerator.transport
    (generator : TraceRewriteGenerator) :
    TraceTransport where
  source := generator.sourceObject
  target := generator.targetObject
  path := TraceRewritePath.ofGenerator generator
  path_source := rfl
  path_target := rfl

/-- The source of the transport attached to a rewrite generator is its source object. -/
theorem TraceRewriteGenerator.transport_source
    (generator : TraceRewriteGenerator) :
    generator.transport.source =
      generator.sourceObject :=
  rfl

/-- The target of the transport attached to a rewrite generator is its target object. -/
theorem TraceRewriteGenerator.transport_target
    (generator : TraceRewriteGenerator) :
    generator.transport.target =
      generator.targetObject :=
  rfl

/-- The path of the transport attached to a rewrite generator is the one-step rewrite path. -/
theorem TraceRewriteGenerator.transport_path
    (generator : TraceRewriteGenerator) :
    generator.transport.path =
      TraceRewritePath.ofGenerator generator :=
  rfl

/-- The trace-correspondence morphism generated by a one-step analytic rewrite. -/
def TraceRewriteGenerator.traceHom
    (generator : TraceRewriteGenerator) :
    generator.sourceObject ⟶ generator.targetObject :=
  TraceCorQHom.singleton
    generator.sourceObject
    generator.targetObject
    1
    generator.transport
    rfl
    rfl

/-- The representable trace-presheaf morphism generated by a one-step analytic rewrite. -/
def TraceRewriteGenerator.representableMap
    (generator : TraceRewriteGenerator) :
    TraceCorQPresheafHom
      (TraceCorQPresheaf.representable generator.sourceObject)
      (TraceCorQPresheaf.representable generator.targetObject) :=
  TraceCorQPresheaf.representableMap generator.traceHom

/-- The representable-subcategory morphism generated by a one-step analytic rewrite. -/
def TraceRewriteGenerator.representableSubcategoryMap
    (generator : TraceRewriteGenerator) :
    (TraceCorQRepresentablePresheaf.yoneda).obj generator.sourceObject ⟶
      (TraceCorQRepresentablePresheaf.yoneda).obj generator.targetObject :=
  (TraceCorQRepresentablePresheaf.yoneda).map generator.traceHom

/-- Forgetting the subcategory map gives the representable presheaf map. -/
theorem TraceRewriteGenerator.representableSubcategoryMap_inclusion
    (generator : TraceRewriteGenerator) :
    TraceCorQRepresentablePresheaf.inclusion.map
        generator.representableSubcategoryMap =
      generator.representableMap :=
  rfl

/-- The trace preimage of the generated representable map is the generated trace hom. -/
theorem TraceRewriteGenerator.representableMap_preimage
    (generator : TraceRewriteGenerator) :
    TraceCorQPresheaf.representablePreimage
        generator.representableMap =
      generator.traceHom :=
  TraceCorQPresheaf.representablePreimage_representableMap
    generator.traceHom

/-- The lifted-Yoneda preimage of the generated subcategory map is the generated trace hom. -/
theorem TraceRewriteGenerator.representableSubcategoryMap_preimage
    (generator : TraceRewriteGenerator) :
    TraceCorQRepresentablePresheaf.yonedaPreimage
        generator.representableSubcategoryMap =
      generator.traceHom :=
  TraceCorQRepresentablePresheaf.yonedaPreimage_yonedaMap
    generator.traceHom

end AnalyticMotives
end LFunctions
end Boundary
