/-- A localization input's source complex has one degree-zero component. -/
theorem TraceLocalizationInput.additiveSourceComplex_objectAt_zero_length
    (input : TraceLocalizationInput) :
    (input.additiveSourceComplex.objectAt 0).length =
      1 :=
  Eq.trans
    (congrArg
      List.length
      (TraceLocalizationInput.additiveSourceComplex_objectAt_zero input))
    (TraceLocalizationInput.additiveSourceObject_length input)

/-- A localization input's target complex has one degree-zero component. -/
theorem TraceLocalizationInput.additiveTargetComplex_objectAt_zero_length
